"{\"total\":169,\"provinces\":[{\"id\":1,\"created_at\":\"2020/12/30 10:55:01\",\"updated_at\":\"2023/05/09 23:04:27\",\"name\":\"北京\"},{\"id\":2,\"created_at\":\"2020/12/30 12:08:03\",\"updated_at\":\"2020/12/30 12:10:56\",\"name\":\"天津\"},{\"id\":3,\"created_at\":\"2020/12/30 12:08:10\",\"updated_at\":\"2020/12/30 12:10:59\",\"name\":\"上海\"},{\"id\":4,\"created_at\":\"2020/12/30 12:10:46\",\"updated_at\":\"2024/03/08 14:51:41\",\"name\":\"江苏\"},{\"id\":5,\"created_at\":\"2020/12/30 12:11:14\",\"updated_at\":\"2022/06/03 19:56:11\",\"name\":\"浙江\"},{\"id\":6,\"created_at\":\"2020/12/30 12:11:29\",\"updated_at\":\"2020/12/30 12:11:29\",\"name\":\"河北\"},{\"id\":7,\"created_at\":\"2020/12/30 12:11:36\",\"updated_at\":\"2020/12/30 12:11:36\",\"name\":\"山西\"},{\"id\":8,\"created_at\":\"2020/12/30 12:11:45\",\"updated_at\":\"2021/12/21 09:28:01\",\"name\":\"辽宁\"},{\"id\":9,\"created_at\":\"2020/12/30 12:11:52\",\"updated_at\":\"2020/12/30 12:11:52\",\"name\":\"吉林\"},{\"id\":10,\"created_at\":\"2020/12/30 12:12:01\",\"updated_at\":\"2020/12/30 12:12:01\",\"name\":\"黑龙江\"},{\"id\":11,\"created_at\":\"2020/12/30 12:12:10\",\"updated_at\":\"2020/12/30 12:12:10\",\"name\":\"安徽\"},{\"id\":12,\"created_at\":\"2020/12/30 17:42:28\",\"updated_at\":\"2020/12/30 17:42:28\",\"name\":\"福建\"},{\"id\":13,\"created_at\":\"2020/12/30 17:42:35\",\"updated_at\":\"2020/12/30 17:42:35\",\"name\":\"江西\"},{\"id\":14,\"created_at\":\"2020/12/30 17:42:41\",\"updated_at\":\"2020/12/30 17:42:41\",\"name\":\"山东\"},{\"id\":15,\"created_at\":\"2020/12/30 17:42:46\",\"updated_at\":\"2020/12/30 17:42:46\",\"name\":\"河南\"},{\"id\":16,\"created_at\":\"2020/12/30 17:42:52\",\"updated_at\":\"2020/12/30 17:42:52\",\"name\":\"湖北\"},{\"id\":17,\"created_at\":\"2020/12/30 17:42:57\",\"updated_at\":\"2024/05/13 14:03:58\",\"name\":\"湖南\"},{\"id\":18,\"created_at\":\"2020/12/30 17:43:05\",\"updated_at\":\"2020/12/30 17:43:05\",\"name\":\"广东\"},{\"id\":19,\"created_at\":\"2020/12/30 17:43:17\",\"updated_at\":\"2020/12/30 17:43:17\",\"name\":\"四川\"},{\"id\":20,\"created_at\":\"2020/12/30 17:43:29\",\"updated_at\":\"2020/12/30 17:43:29\",\"name\":\"陕西\"},{\"id\":21,\"created_at\":\"2020/12/30 17:43:39\",\"updated_at\":\"2020/12/30 17:45:21\",\"name\":\"重庆\"},{\"id\":22,\"created_at\":\"2020/12/30 17:43:45\",\"updated_at\":\"2020/12/30 17:43:45\",\"name\":\"贵州\"},{\"id\":23,\"created_at\":\"2020/12/30 17:43:52\",\"updated_at\":\"2020/12/30 17:43:52\",\"name\":\"云南\"},{\"id\":24,\"created_at\":\"2020/12/30 17:44:02\",\"updated_at\":\"2020/12/30 17:44:02\",\"name\":\"甘肃\"},{\"id\":25,\"created_at\":\"2020/12/30 17:44:10\",\"updated_at\":\"2020/12/30 17:44:10\",\"name\":\"青海\"},{\"id\":26,\"created_at\":\"2020/12/30 17:44:20\",\"updated_at\":\"2020/12/30 17:44:20\",\"name\":\"新疆\"},{\"id\":27,\"created_at\":\"2020/12/30 17:44:27\",\"updated_at\":\"2020/12/30 17:44:27\",\"name\":\"宁夏\"},{\"id\":28,\"created_at\":\"2020/12/30 17:44:35\",\"updated_at\":\"2020/12/30 17:44:35\",\"name\":\"西藏\"},{\"id\":29,\"created_at\":\"2020/12/30 17:44:41\",\"updated_at\":\"2020/12/30 17:44:41\",\"name\":\"广西\"},{\"id\":30,\"created_at\":\"2020/12/30 17:44:48\",\"updated_at\":\"2020/12/30 17:45:38\",\"name\":\"海南\"},{\"id\":31,\"created_at\":\"2020/12/30 17:45:46\",\"updated_at\":\"2020/12/30 17:45:46\",\"name\":\"内蒙古\"},{\"id\":32,\"created_at\":\"2022/04/13 11:05:29\",\"updated_at\":\"2022/04/13 11:05:29\",\"name\":\"香港\"},{\"id\":33,\"created_at\":\"2026/03/25 10:39:28\",\"updated_at\":\"2026/03/25 10:39:28\",\"name\":\"澳门\"}],\"colleges\":[{\"id\":1,\"name\":\"清华大学\",\"en_name\":\"Tsinghua University\",\"tags\":\"教育部直属,综合, 双一流,985工程,211工程\",\"ranks\":\"1,1,14,23,2,1\",\"rank\":1,\"province_id\":1,\"info\":\"清华大学的前身清华学堂始建于1911年，1928年更名为国立清华大学。抗日战争全面爆发后南迁，与北京大学、南开大学组建为国立西南联合大学；1946年迁回清华园。1952年全国高等学校院系调整后，清华大学成为一所多科性工业大学，先后恢复或新建了理科、经济、管理和文科类学科，与中央工艺美术学院、原中国人民银行研究生部等合并。清华大学为教育部直属高校，是教育部与北京市人民政府、国家国防科技工业局、水利部、国家海洋局、国家卫生健康委员会共建的全国重点大学。\"},{\"id\":2,\"name\":\"北京大学\",\"en_name\":\"Peking University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"2,2,12,39,1,2\",\"rank\":2,\"province_id\":1,\"info\":\"北京大学的前身是1898年创立的京师大学堂，1912年改为现名。1937年与清华大学、南开大学南迁长沙，共同组建国立长沙临时大学，1938年迁至昆明，改称国立西南联合大学；1946年迁回北平复学；2000年与原北京医科大学合并，组建成新的北京大学。北京大学为教育部直属高校，副部级建制，由教育部和北京市人民政府重点共建，是中国乃至亚洲最著名的高等学府之一。\"},{\"id\":49,\"name\":\"浙江大学\",\"en_name\":\"Zhejiang University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"5,3,43,93,67,5\",\"rank\":3,\"province_id\":5,\"info\":\"浙江大学是一所历史悠久、声誉卓著的高等学府，坐落于中国历史文化名城、风景旅游胜地杭州。学校的前身求是书院创立于1897年，为中国人自己最早创办的新式高等学校之一。浙江大学学科涵盖哲学、经济学、法学、教育学、文学、历史学、艺术学、理学、工学、农学、医学、管理学等十二个门类。在国家公布的“双一流”建设名单中，学校入选一流大学建设高校（A类），18个学科入选一流建设学科，居全国高校第三。\"},{\"id\":34,\"name\":\"上海交通大学\",\"en_name\":\"Shanghai Jiao Tong University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"4,4,46,89,4,4\",\"rank\":4,\"province_id\":3,\"info\":\"中国历史最悠久的大学，“综合性、创新型、国际化”的高等学府，拥有坚实的理科，强大的工科、生命医学学科，高水平、精品化的经济学、人文、法学和农学。在工、商、医三大领域拥有极高影响力，自然基金数连续11年全国第一，被誉为近20年发展最快的中国高校。软科世界一流学科前十排名内地高校第二。积极培育具有“梦想和激情、想象力和好奇心、系统知识体系和跨界思维及创新实践力，引领未来”的交大人！\"},{\"id\":35,\"name\":\"复旦大学\",\"en_name\":\"Fudan University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"6,5,34,116,7,6\",\"rank\":5,\"province_id\":3,\"info\":\"复旦大学起源于1905年创立的复旦公学，1917年定名为复旦大学并沿用至今。1937年复旦大学部分师生内迁重庆北培（渝校），1946年渝校迁回上海与沪校合并；2000年复旦大学与上海医科大学合并，组建为新的复旦大学。复旦大学为教育部直属高校，副部级建制，“九校联盟”（C9）成员，由教育部和上海市人民政府重点共建，是中国最著名的高等学府之一。\"},{\"id\":3,\"name\":\"南京大学\",\"en_name\":\"Nanjing University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"6,6,141,123,7,3\",\"rank\":6,\"province_id\":4,\"info\":\"南京大学是一所历史悠久、声誉卓著的高等学府。其前身是创建于1902年的三江师范学堂，此后历经两江师范学堂、南京高等师范学校、国立东南大学、国立第四中山大学、国立中央大学、国立南京大学等历史时期，于1950年更名为南京大学。1952年，在全国高校院系调整中做出了卓越贡献。在一个多世纪的办学历程中，南京大学及其前身与时代同呼吸、与民族共命运，谋国家之强盛、求科教之进步，为国家的富强和民族的振兴做出了重要的贡献。首批入选国家“211工程”和“985工程”建设序列，首批入选国家“双一流”建设高校，始终处于中国大学的第一方阵。\"},{\"id\":64,\"name\":\"中国科学技术大学\",\"en_name\":\"University of Science and Technology of China\",\"tags\":\"教育部直属,理工,双一流,985工程,211工程\",\"ranks\":\"7,9\",\"rank\":7,\"province_id\":11,\"info\":\"中国科学技术大学是“985工程”和“211工程”，A类世界一流大学建设高校，是一所以前沿科学和高新技术为主，兼有医学、特色管理和人文学科的综合性全国重点大学。中国科大是为“两弹一星”事业而创办的一所大学，她的创办被称为“我国教育史和科学史上的一项重大事件”。7个A+学科，数量居全国高校第五，“数理化天地生”六个基础学科全部被评为A或A+，全国高校唯一！26个本科专业获得国家级一流专业建设点认定。\"},{\"id\":119,\"name\":\"中国科学院大学\",\"en_name\":\"University of Chinese Academy of Sciences\",\"tags\":\"高等院校,理工类,双一流,科研院所\",\"ranks\":\"8,/,/,/,/,9\",\"rank\":7,\"province_id\":1,\"info\":\"中国科学院大学简称“国科大”，是一所以科教融合为办学模式、研究生教育为办学主体、精英化本科教育为办学特色的创新型大学。 国科大的研究生教育，发端于中国科学院的人才培养。1950年，中国科学院启动研究实习员的招考和培养工作。1951年6月，中国科学院与中央教育部联合发布《中国科学院所属研究机构、中央教育部所属高等学校研究部一九五一年暑期招收研究实习员、研究生办法》。1955年8月，《中国科学院研究生暂行条例》由周恩来总理签发后颁布实施。1964年9月，中国科学院在北京试办“中国科学院研究生院”。 1977年，中国科学院率先恢复研究生招生，为适应各研究所招收和培养研究生的需要，在北京成立了中国科学技术大学研究生院。1978年，恢复招生后的首批研究生入学。1982年，中国科学院党组批准研究生院同时使用“中国科学院研究生院”、“中国科学技术大学研究生院”两个名称。\"},{\"id\":78,\"name\":\"华中科技大学\",\"en_name\":\"Huazhong University of Science and Technology\",\"tags\":\"教育部直属,理工,双一流,985工程,211工程\",\"ranks\":\"8,5\",\"rank\":8,\"province_id\":16,\"info\":\"华中科技大学是国家教育部直属重点综合性大学，由原华中理工大学、同济医科大学、武汉城市建设学院于2000年5月26日合并成立，是国家“211工程”重点建设和“985工程”建设高校之一，是首批“双一流”建设高校。学校机械工程等9个学科入选国家“双一流”建设学科。\"},{\"id\":60,\"name\":\"哈尔滨工业大学\",\"en_name\":\"Harbin Institute of Technology\",\"tags\":\"教育部直属,理工,双一流,985工程,211工程\",\"ranks\":\"13,10\",\"rank\":9,\"province_id\":10,\"info\":\"哈尔滨工业大学的前身是创办于1920年的哈尔滨中俄工业学校，1938年正式定名为哈尔滨工业大学并沿用至今；2000年与哈尔滨建筑大学合并组建新的哈尔滨工业大学。哈尔滨工业大学是工业和信息化部直属高校，是工业和信息化部与教育部、黑龙江人民政府、国家海洋局共建的全国重点大学。\"},{\"id\":77,\"name\":\"武汉大学\",\"en_name\":\"Wuhan University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"9,8\",\"rank\":9,\"province_id\":16,\"info\":\"武汉大学是国家教育部直属重点综合性大学，首批“985”、“211”重点高校，首批“双一流”建设重点高校。武汉大学共12个学科门类，6大学部，34个学院（系），127个本科专业，共75门课程入选首批国家级一流本科课程，55个专业入选国家级一流本科专业建设点。教育部第四轮学科评估中，武汉大学19个学科被评为A类，其中马克思主义理论、地球物理学、测绘科学与技术、图书情报与档案管理位列全国第一。\"},{\"id\":97,\"name\":\"西安交通大学\",\"en_name\":\"Xi'an Jiaotong University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"10,14\",\"rank\":10,\"province_id\":20,\"info\":\"西安交通大学是国家教育部直属重点大学，为我国最早兴办的高等学府之一。其前身是1896年创建于上海的南洋公学，1921年改称交通大学，1956年内迁西安，1959年定名为西安交通大学。学校首批进入国家“211”和“985”工程建设，2017年入选一流大学A类建设高校。建校125年来，为国家培养了以200余位两院院士为代表的大批杰出人才。\"},{\"id\":87,\"name\":\"中山大学\",\"en_name\":\"Sun Yat-Sen University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"11,15\",\"rank\":11,\"province_id\":18,\"info\":\"中山大学由孙中山先生亲手创办，是教育部直属高校，国家“985工程” “211工程”重点建设的高水平研究型综合性大学，首批“双一流”建设A类高校。中山大学文理医工农艺学科齐全，各具特色、融合发展,地处粤港澳大湾区，现由广州校区、珠海校区、深圳校区三个校区、五个校园（招生代码统一为10558）及10家附属医院组成，综合实力居内地高校前八。\"},{\"id\":92,\"name\":\"四川大学\",\"en_name\":\"Sichuan University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"12,18,10,406\",\"rank\":12,\"province_id\":19,\"info\":\"四川大学是教育部直属全国重点大学，是国家布局在中国西部的重点建设的高水平研究型综合大学。四川大学地处中国历史文化名城——“天府之国”的成都，有望江、华西和江安三个校区，占地面积7050亩，校舍建筑面积269.4万平方米。校园环境幽雅、花木繁茂、碧草如茵、景色宜人，是读书治学的理想园地。\"},{\"id\":123,\"name\":\"国防科技大学\",\"en_name\":\"National University of Defense Technology\",\"tags\":\"985工程,211工程,双一流,军校\",\"ranks\":\"/,/\",\"rank\":12,\"province_id\":17,\"info\":\"国防科技大学的前身是1953年创建于哈尔滨的中国人民解放军军事工程学院，即著名的“哈军工”，陈赓大将任首任院长兼政治委员。“哈军工”创办于朝鲜战争期间，是新中国第一所高等军事工程学院，其卓越的办学成效铸就了我国国防科技和高等教育史上一座丰碑。1970年，学院主体南迁长沙，改名为长沙工学院。1978年，改建为中国人民解放军国防科学技术大学。1999年，长沙炮兵学院、长沙工程兵学院和长沙政治学院并入国防科学技术大学。2017年，中央军委决策，以国防科学技术大学、国际关系学院、国防信息学院、西安通信学院、电子工程学院，以及理工大学气象海洋学院为基础，重建国防科技大学，并将军委装备发展部第63研究所划归国防科技大学，归军委建制领导。\"},{\"id\":8,\"name\":\"北京航空航天大学\",\"en_name\":\"Beihang University\",\"tags\":\"教育部直属,理工,双一流,985工程,211工程\",\"ranks\":\"14,17\",\"rank\":14,\"province_id\":1,\"info\":\"北航成立于1952年，是首批16所全国重点大学之一，是国家“211工程”、“985工程”、“2011计划”重点建设高校，2017年成为国家“双一流”建设A类高校。如今北航已成为一所国内一流、世界知名的综合性研究型大学，展现出三个显著特点：一是高精尖：学科专业和研究方向尖端。二是有贡献：贡献了很多国内第一的科研成果。三是前景好：未来去向“三高一多”，即就业率高、升学率高、薪酬待遇高、主流行业多。\"},{\"id\":4,\"name\":\"东南大学\",\"en_name\":\"Southeast University\",\"tags\":\"教育部直属, 理工,双一流,985工程,211工程\",\"ranks\":\"15,21\",\"rank\":15,\"province_id\":4,\"info\":\"东南大学是中央直管、教育部直属的全国重点大学，是“985工程”和“211工程”重点建设大学之一，入选世界一流大学建设A类高校。在近120年办学历程中，形成了“严谨、求实、团结、奋进”的优良校风和“以科学名世、以人才报国”的办学理念，铸就了“止于至善”的校训精神。如今的东南大学已成为一所以工科为主要特色，理学、工学、医学、文学、法学、哲学、教育学、经济学、管理学等多学科协调发展的综合性、研究型大学。\"},{\"id\":9,\"name\":\"北京理工大学\",\"en_name\":\"Beijing Institute of Technology\",\"tags\":\"教育部直属,理工,双一流,985工程,211工程\",\"ranks\":\"16,25\",\"rank\":16,\"province_id\":1,\"info\":\"北京理工大学创办于1940年，前身是诞生于延安的自然科学院，是中国共产党创建的第一所理工科大学，亦是新中国第一所国防工业院校。北京理工大学是国家历批次重点建设的高校，首批设立研究生院，首批入选“211 工程”、“985工程”（北京第3所）、“世界一流大学”建设高校A类行列，现隶属于工业和信息化部。\"},{\"id\":36,\"name\":\"同济大学\",\"en_name\":\"Tongji University\",\"tags\":\"教育部直属 ,理工,双一流,985工程,211工程\",\"ranks\":\"19,17\",\"rank\":17,\"province_id\":3,\"info\":\"同济大学的前身是1907年创立的德文医学堂；1927年改称国立同济大学；1952年院系调整后，同济大学成为国内土木建筑领域规模最大、学科最全的工科大学；2000年与上海铁道大学合并，组建成新的同济大学。同济大学为教育部直属高校，是教育部和上海市人民政府、国家海洋局共建的全国重点大学。\"},{\"id\":7,\"name\":\"中国人民大学\",\"en_name\":\"Renmin University of China\",\"tags\":\"教育部直属,985工程,211工程,双一流\",\"ranks\":\"18\",\"rank\":18,\"province_id\":1,\"info\":\"中国人民大学的前身是1937年创办于延安的陕北公学，以及后来的华北联合大学和华北大学。1949年，中央人民政府政务院通过了《关于成立中国人民大学的决定》。1950年，以华北大学为基础合并组建的中国人民大学正式开学，成为中华人民共和国创办的第一所新型正规大学。中国人民大学现为教育部直属高校，副部级建制，是教育部和北京市人民政府共建的全国重点大学。\"},{\"id\":10,\"name\":\"北京师范大学\",\"en_name\":\"Beijing Normal University\",\"tags\":\"教育部直属,师范,双一流,985工程,211工程\",\"ranks\":\"19,12\",\"rank\":19,\"province_id\":1,\"info\":\"北京师范大学，创办于1902年，是教育部直属重点大学，是一所以教师教育、教育科学和文理基础学科为主要特色的著名学府。百年砥砺，铸就了北师大丰富的文化底蕴、突出的学科优势和雄厚的教育资源。“七五”“八五”期间就是国家重点建设的十所大学之一，是首批列入“211工程”，一期“985工程”高校，2017年入选一流大学建设高校A类名单。近年来ARWU等权威世界大学排名中，均居内地高校前列。 北京师范大学学科综合实力位居全国前十，学科点覆盖了除军事学以外的12个学科门类，形成了综合性学科布局。\"},{\"id\":31,\"name\":\"南开大学\",\"en_name\":\"Nankai University\",\"tags\":\"教育部直属,985工程,211工程,双一流\",\"ranks\":\"20,12\",\"rank\":20,\"province_id\":2,\"info\":\"南开大学创办于1919年；1937年与北京大学、清华大学合组国立长沙临时大学；1946年迁回天津复校；中华人民共和国成立后，经历高等教育院系调整，成为文理并重的全国重点大学；1994年天津对外经贸学院并入，2010年中国旅游管理干部学院并入。南开大学为教育部直属高校，副部级建制，是教育部与天津市人民政府共建的全国重点大学。\"},{\"id\":32,\"name\":\"天津大学\",\"en_name\":\"Tianjin University\",\"tags\":\"211,985,双一流\",\"ranks\":\"21,21\",\"rank\":21,\"province_id\":2,\"info\":\"天津大学是教育部直属国家重点大学，“985工程”、“211工程”首批重点建设大学、入选国家“世界一流大学建设”A类高校。学校创建于1895年，前身北洋大学是我国第一所现代大学，至今已有125年的历史。学校1959年被中共中央确定为首批16所国家重点大学之一，是2012年首批14个国家级“2011协同创新中心”高校之一，2017年“新工科”建设天大路线图提出高校。学校面向未来提出“强工”、“厚理”、“振文”、“兴医”的综合发展理念。 天大汇聚了大批杰出的学术带头人和教科研精英。其中两院院士14人，“973”首席科学家17人，国家杰出青年基金获得者54人，国家优秀青年基金获得者59人，中组部“万人计划”入选者51人、国务院参事、中国文联副主席冯骥才先生等一大批顶尖科学家、艺术家都在天大育人授业。 在教育部公布的2017年学科评估（第四轮）结果中，天津大学14个一级学科进入A类，数量位居全国第四，彰显了学校的整体优势。化学工程与技术进入A+档，再次蝉联全国第1，实现了四连冠。\"},{\"id\":132,\"name\":\"北京协和医学院\",\"en_name\":\"Peking Union Medical College\",\"tags\":\"双一流,中国医学科学院,顶尖医学学府\",\"ranks\":\"1,1\",\"rank\":21,\"province_id\":1,\"info\":\"北京协和医学院是国家卫生健康委员会唯一直属“双一流”建设院校、与中国医学科学院实行院校合一的管理体制，最早由美国洛克菲勒基金会于1917年创办，它最早开启了我国八年制临床医学教育的先河，依照北美优秀医学院的入学标准严格控制招生数量，小规模特色培养，是中国现代医学教育的发源地，培养医学精英人才的摇篮。在中国现代医学的各个领域，协和人或成为奠基人，或成为开拓者。\"},{\"id\":73,\"name\":\"山东大学\",\"en_name\":\"Shandong University\",\"tags\":\"211,985,双一流\",\"ranks\":\"22，15\",\"rank\":22,\"province_id\":14,\"info\":\"山东大学是一所历史悠久、学科齐全、实力雄厚、特色鲜明，在国内外具有重要影响的教育部直属重点综合性大学，是世界一流大学建设高校（A类）。 山东大学主体是1901年创办的山东大学堂，百余年间，山东大学秉承“为天下储人才，为国家图富强”的办学宗旨，践行“学无止境，气有浩然”的校训，踔厉奋发，薪火相传，形成了“崇实求新”的校风，为国家和社会培养了60余万各类人才，为国家和区域经济社会发展做出了重要贡献。\"},{\"id\":70,\"name\":\"厦门大学\",\"en_name\":\"Xiamen University\",\"tags\":\"教育部直属,综合,双一流,985工程,211工程\",\"ranks\":\"24,20\",\"rank\":23,\"province_id\":12,\"info\":\"厦门大学创办于1921年，是中国近代教育史上第一所由华侨创办的大学；1937年改为国立厦门大学；1952年全国院系调整时厦门大学大部分院系陆续调出，调整后只保留文理学院，成为文理综合性大学。厦门大学为教育部直属高校，副部级建制，是教育部、福建省人民政府和厦门市人民政府共建的全国重点大学。\"},{\"id\":84,\"name\":\"中南大学\",\"en_name\":\"Central South University\",\"tags\":\"211,985,双一流\",\"ranks\":\"23,26\",\"rank\":24,\"province_id\":17,\"info\":\"中南大学由湖南医科大学、长沙铁道学院和中南工业大学于2000年合并组建而成，其中湖南医科大学的前身为创建于1914年的湘雅医学专门学校，长沙铁道学院的前身为组建于1953年的中南土木建筑学院，中南工业大学的前身为组建于1952年的中南矿治学院。中南大学现为教育部直属高校，是教育部、国家卫生健康委员会、湖南省人民政府共建的全国重点大学。\"},{\"id\":98,\"name\":\"西北工业大学\",\"en_name\":\"Northwestern Polytechnical University\",\"tags\":\"211,985,双一流\",\"ranks\":\"25,23\",\"rank\":25,\"province_id\":20,\"info\":\"西北工业大学（以下简称西工大）坐落于陕西西安，是一所以发展航空、航天、航海（三航）等领域人才培养和科学研究为特色的多科性、研究型、开放式大学，是国家“一流大学”建设高校（A类），隶属于工业和信息化部。学校1960年被国务院确定为全国重点大学，“七五”“八五”均被国务院列为重点建设的全国15所大学之一，1995年首批进入“211工程”，2001年进入“985工程”，是“卓越大学联盟”成员高校。\"},{\"id\":88,\"name\":\"华南理工大学\",\"en_name\":\"South China University of Technology\",\"tags\":\"211,985,双一流\",\"ranks\":\"26,24\",\"rank\":26,\"province_id\":18,\"info\":\"华南理工大学地处广州，是直属教育部的全国重点大学，是首届“全国文明校园”获得单位。学校办学源远流长，正式组建于1952年，为新中国四大工学院之一；1981年经国务院批准为首批博士和硕士学位授予单位；1995年进入“211工程”行列；2001年进入“985工程”行列；2017年入选“双一流”建设A类高校名单，2020年在“世界大学学术排名”中排名第151-200位。\"},{\"id\":93,\"name\":\"电子科技大学\",\"en_name\":\"University of Electronic Science and Technology of China\",\"tags\":\"理工,双一流,985工程,211工程\",\"ranks\":\"28,30\",\"rank\":27,\"province_id\":19,\"info\":\"电子科技大学于1956年在周恩来总理的亲自部署创建而成。2001年进入国家“985工程”重点建设大学行列，2017年进入国家建设“世界一流大学”A类高校行列。2019年教育部和四川省签约共同推进我校世界一流大学建设。经过60余年的建设，学校形成了从本科到硕士研究生、博士研究生等多层次、多类型的人才培养格局，成为一所完整覆盖整个电子信息类学科，以电子信息科学技术为核心，以工为主，理工渗透，理、工、管、文、医协调发展的多科性研究型大学，成长为国内电子信息领域高新技术的源头，创新人才的基地。 　　学校坚持学生为中心、通专结合，以“价值塑造、启迪思想、唤起好奇、激发潜能、探究知识、个性发展”六位一体为培养理念，致力于培养具有家国情怀、全球素养、扎实基础、知识综合与集成创新能力，未来能引领学术前沿、科技与社会经济发展，堪当民族复兴大任的创新引领性人才。学校现有2个国家一级重点学科（所包括的6个二级学科均为国家重点学科）、2个国家重点（培育）学科。在第四轮全国一级学科评估中，学校4个学科获评A类，其中电子科学与技术、信息与通信工程两个学科为A+，A+学科数并列西部高校第一。\"},{\"id\":57,\"name\":\"吉林大学\",\"en_name\":\"Jilin University\",\"tags\":\"211,985,双一流\",\"ranks\":\"22,15\",\"rank\":28,\"province_id\":9,\"info\":\"吉林大学是教育部直属的全国重点综合性大学，坐落在吉林省长春市。学校始建于1946年，1960年被列为国家重点大学，1984年成为首批建立研究生院的22所大学之一，1995年首批通过国家教委“211工程”审批，2001年被列入“985工程”国家重点建设的大学，2004年被批准为中央直接管理的学校，2017年入选国家一流大学建设高校。\"},{\"id\":14,\"name\":\"北京邮电大学\",\"en_name\":\"Beijing University of Posts and Telecommunications\",\"tags\":\"北京,教育部直属,理工,双一流,211工程\",\"ranks\":\"57,48\",\"rank\":29,\"province_id\":1,\"info\":\"北京邮电大学是教育部直属、工业和信息化部共建、首批进行“211工程”建设的全国重点大学，是“985优势学科创新平台”项目重点建设高校，是一所以信息科技为特色、工学门类为主体、工管文理协调发展的多科性、研究型大学，是我国信息科技人才的重要培养基地。 学校信息与通信工程、计算机科学与技术以及电子科学与技术三个一级学科在教育部第四轮学科评估中被评为A类学科，其中信息与通信工程取得了A+的优异成绩。\"},{\"id\":85,\"name\":\"湖南大学\",\"en_name\":\"Hunan University\",\"tags\":\"211,985,双一流\",\"ranks\":\"29,31\",\"rank\":29,\"province_id\":17,\"info\":\"湖南大学位于中国历史文化名城长沙，校区坐落在湘江之滨、岳麓山下，享有“千年学府，百年名校”之誉。学校办学历史悠久、教育传统优良，是教育部直属全国重点大学、国家“211工程”“985工程”重点建设高校、国家“世界一流大学”建设高校。\"},{\"id\":37,\"name\":\"华东师范大学\",\"en_name\":\"East China Normal University\",\"tags\":\"211,985,双一流\",\"ranks\":\"25,31\",\"rank\":30,\"province_id\":3,\"info\":\"华东师范大学以1924年创办的大夏大学和1925年创办的光华大学为基础，调入复旦大学、同济大学、浙江大学和圣约翰大学等高校的部分系科后，于1951年在大夏大学的原址上正式成立；1972年与上海师范学院、上海体育学院等院校合并，改名为上海师范大学，1980年恢复华东师范大学校名。华东师范大学为教育部直属高校，是教育部和上海市人民政府重点共建的全国重点大学。\"},{\"id\":54,\"name\":\"大连理工大学\",\"en_name\":\"Dalian University of Technology\",\"tags\":\"211,985,双一流\",\"ranks\":\"32,28\",\"rank\":31,\"province_id\":8,\"info\":\"大连理工大学（简称“大工”）成立于1949年4月，时为大连大学工学院，1950年大连大学建制撤销独立为大连工学院，1988年更名为大连理工大学。大工是中国共产党在新中国成立前夕面向新中国工业体系建设亲手创办的第一所新型正规大学，是教育部直属全国重点大学，新中国“四大工学院”之一。学校已形成以理工为主，理、工、经、管、文、法、哲、艺术等协调发展的多学科育人体系。\"},{\"id\":104,\"name\":\"重庆大学\",\"en_name\":\"Chongqing University\",\"tags\":\"211,985,双一流\",\"ranks\":\"34,33\",\"rank\":33,\"province_id\":21,\"info\":\"重庆大学始建于1929年，是教育部直属、国家“211工程”、“985工程”重点建设的高水平研究型综合性大学，国家“世界一流大学（A类）”建设高校。经过90多年发展和积淀，已成为一所具有远大理想、崇高使命、强烈担当、独特文化的大学。学校共有四个校区，全日制在校学生47000余人。2021年学校成立本科生院，全面推进大类招生、大类培养、大类管理，86个普通类专业将按照10个大类（“3+1+2”新高考改革8省市整合成12个大类）进行招生。\"},{\"id\":11,\"name\":\"中国农业大学\",\"en_name\":\"China Agricultural University\",\"tags\":\"211,985,双一流\",\"ranks\":\"30,27\",\"rank\":34,\"province_id\":1,\"info\":\"中国农业大学是“211”工程、“985”工程、双一流建设（A类）高校，是以农学、生命科学、农业工程和食品科学等学科为特色和优势的研究型大学，形成了特色鲜明、优势互补的农业与生命科学、资源与环境科学、信息与计算机科学、农业工程与自动化科学、经济管理与社会科学等学科群。9个A级学科，6个A+学科，获评A+的学科数量居全国\"},{\"id\":38,\"name\":\"上海财经大学\",\"en_name\":\"Shanghai University of Finance and Economics\",\"tags\":\"211,双一流\",\"ranks\":\"34,59\",\"rank\":36,\"province_id\":3,\"info\":\"上海财经大学源于1917年南京高等师范学校创办的商科，至今已有一百多年的历史，是中国高等教育史上最早的商科大学。1985年，学校更名为上海财经大学，1996年进入国家“211工程”建设行列，2005年入选“985工程优势学科创新平台”建设高校，2012年教育部、财政部和上海市人民政府签约共建上海财经大学，2017年首批入选“双一流”建设高校。当前正全面开启鲜明财经特色世界一流大学建设新征程。\"},{\"id\":53,\"name\":\"东北大学\",\"en_name\":\"Northeastern University\",\"tags\":\"211,985,双一流\",\"ranks\":\"38,43\",\"rank\":36,\"province_id\":8,\"info\":\"东北大学始建于1923年；1949年以东北大学工学院和理学院（部分）为基础建立沈阳工学院；1952年先后有大连工学院电机系、哈尔滨工业大学采矿系和冶金系、山东大学采矿系并入，地质系、数学系、物理系划出；1993年复名东北大学；1995年沈阳黄金学院并入。东北大学现为教育部直属高校，是教育部、辽宁省人民政府、沈阳市人民政府共建的全国重点大学。\"},{\"id\":103,\"name\":\"西安电子科技大学\",\"en_name\":\"Xidian University\",\"tags\":\"211,双一流\",\"ranks\":\"39,45\",\"rank\":38,\"province_id\":20,\"info\":\"西安电子科技大学是以信息与电子学科为主，工、理、管、文多学科协调发展的全国重点大学，直属教育部，是国家“优势学科创新平台”项目和“211工程”项目重点建设高校之一、国家双创示范基地之一、首批35所示范性软件学院、首批9所示范性微电子学院、首批9所获批设立集成电路人才培养基地和首批一流网络安全学院建设示范项目的高校之一。2017年学校信息与通信工程、计算机科学与技术入选国家“双一流”建设学科。\"},{\"id\":108,\"name\":\"兰州大学\",\"en_name\":\"Lanzhou University\",\"tags\":\"211,985,双一流\",\"ranks\":\"40,29\",\"rank\":39,\"province_id\":24,\"info\":\"兰州大学创建于1909年，是教育部直属的全国重点综合性大学，是国家“211工程”“985工程”和“双一流”建设（A类）高校。拥有10个国家重点学科（含培育）。化学、大气科学、生态学、草学4个学科入选世界一流学科建设名单。13个学科进入ESI全球前1%，其中化学学科进入ESI全球前1‰。人才培养成果卓著，近20年来，培养的学生当选院士、杰青、优青的人数均位居全国前列。\"},{\"id\":16,\"name\":\"北京科技大学\",\"en_name\":\"University of Science and Technology Beijing\",\"tags\":\"211,双一流\",\"ranks\":\"35,32\",\"rank\":40,\"province_id\":1,\"info\":\"北京科技大学是教育部直属全国重点大学，国家“双一流”建设高校，国家首批“211工程”建设高校，“985 工程”优势学科创新平台建设高校，国防科工局、教育部共建高校，是全国首批成立研究生院的22所高校之一，入选了国家“2011计划”。北科大在国际上享有盛名，“2020软科世界大学学术排名”位列全球300强，2021年软科发布的大学排行榜中位列大陆地区高校第33（一流学科高校中排名第1）。北科大是一所在国家科技发展进程中做出卓越贡献的高等学府。\"},{\"id\":44,\"name\":\"南京理工大学\",\"en_name\":\"Nanjing University of Science and Technology\",\"tags\":\"211,双一流\",\"ranks\":\"36,40\",\"rank\":41,\"province_id\":4,\"info\":\"南京理工大学是隶属于工业和信息化部，由工信部、教育部与江苏省人民政府共建的全国重点大学，是国家“世界一流学科建设高校”、国家“211工程”、“985工程优势学科创新平台”重点建设高校，“兵器科学与技术”学科入选“双一流”建设学科。王泽山院士获得2017年度国家最高科学技术奖，习近平总书记亲自为王院士颁奖。学校坚持“以人为本，厚德博学”办学理念，致力于促进陆海空天信融合发展，建设特色鲜明世界一流大学\"},{\"id\":6,\"name\":\"南京航空航天大学\",\"en_name\":\"Nanjing University of Aeronautics and Astronautics\",\"tags\":\"211,双一流\",\"ranks\":\"\",\"rank\":42,\"province_id\":4,\"info\":\"南京航空航天大学是新中国创办的首批航空高等院校之一，隶属于工业和信息化部，是教育部、民航局、江苏省共建的国家“双一流”建设高校、国家“211工程”建设重点大学、“985工程优势学科创新平台”重点建设高校，全国文明校园。南航遵循“团结、俭朴、唯实、创新”的校风，践行“智周万物，道济天下”的校训，推动学校的快速发展，现已成为以工为主，理工结合，工、理、经、管、文等多学科协调发展，具有航空航天民航特色的\"},{\"id\":46,\"name\":\"苏州大学\",\"en_name\":\"Soochow University (China)\",\"tags\":\"211,双一流\",\"ranks\":\"40,42\",\"rank\":43,\"province_id\":4,\"info\":\" 苏州大学坐落于素有“人间天堂”之称的历史文化名城苏州，是国家“双一流”建设高校和“211工程”、“2011计划”首批入列高校，是教育部与江苏省、国防科工局与江苏省共建高校，也是江苏省属重点综合性大学。学校现设有30个学院（部），132个本科专业，49个一级学科硕士点，33个专业学位硕士点，28个一级学科博士点，1个专业学位博士点，30个博士后流动站。\"},{\"id\":15,\"name\":\"北京交通大学\",\"en_name\":\"Beijing jiaotong University\",\"tags\":\"211,双一流\",\"ranks\":\"43,35\",\"rank\":44,\"province_id\":1,\"info\":\"北京交通大学是教育部直属，教育部、交通运输部、北京市人民政府和中国国家铁路集团有限公司共建的全国重点大学，“211工程”“985工程优势学科创新平台”项目建设高校。学校牵头的“2011计划”“轨道交通安全协同创新中心”是国家首批14个认定的协同创新中心之一。学校是国家首批“双一流”建设高校，首轮建设任务已顺利完成，“智慧交通”一流学科领域建设得到评审专家高度评价。\"},{\"id\":41,\"name\":\"华东理工大学\",\"en_name\":\"East China University of Science and Technology\",\"tags\":\"211,双一流\",\"ranks\":\"44,36\",\"rank\":45,\"province_id\":3,\"info\":\"华东理工大学的前身为1952年由交通大学、震旦大学、大同大学、东吴大学、江南大学等高校化工系合并组建的华东化工学院，是中华人民共和国第一所以化工特色闻名的高等学府，在历经多次专业和院系的调整后，于1993年定名华东理工大学。华东理工大学现为教育部直属高校，是教育部、上海市人民政府、中国石油化工集团有限公司共建的全国重点大学。\"},{\"id\":121,\"name\":\"南方科技大学\",\"en_name\":\"Southern University of Science and Technology\",\"tags\":\"双一流,新型大学,研究型大学\",\"ranks\":\"\",\"rank\":45,\"province_id\":18,\"info\":\"南方科技大学（简称：南科大）是深圳在中国高等教育改革发展的宏观背景下创建的一所高起点、高定位的公办创新型大学。学校借鉴世界一流理工科大学的学科设置和办学模式，以理、工、医为主，兼具商科和特色人文社科的多元化学科，在本科、硕士、博士层次办学，在一系列新的学科方向上开展研究，使学校成为引领社会发展的思想库和新知识、新技术的源泉。\"},{\"id\":82,\"name\":\"华中农业大学\",\"en_name\":\"Huazhong Agricultural University\",\"tags\":\"211,双一流\",\"ranks\":\"42,37\",\"rank\":47,\"province_id\":16,\"info\":\"华中农业大学是国家公办、全日制普通高等学校，是教育部直属全国重点大学，是国家“双一流”建设高校。注册地址为湖北省武汉市洪山区狮子山1号，邮编430070。 学校经过一百多年的发展，已形成以农科为优势，以生命科学为特色，农、理、工、医、文、法、经、管、艺等多学科相结合，学科优势明显，新兴与传统学科交融的发展格局。学校本科34个专业（类），面向全国31个省（市、区）招收普通本科生4760名，招生类型包括：普通本科、国家专项计划、高校专项计划、保送生、艺术类、高水平艺术团、高水平运动队、少数民族预科班、内地新疆班、内地西藏班等类型。学校以实施招生“阳光工程” 为原则，以规范招生管理、提高生源质量为目标，以拓宽渠道、丰富形式开展招生宣传为途径，积极拓展招生类型，不断总结经验，确保了招生工作的公开、公平、公正。 学校承诺决不让一个学生因家庭经济困难而失学，建立起以“一体四翼”为主要内容的本科生资助政策体系。“一体”即构建“一、二、四、五”资助体系，包括开辟一条新生入学绿色通道；设立“奖、贷、补”资金和勤工助学基金等专项资助经费；建立以经济资助为基础、心理帮扶为保障、学习帮助为关键、就业援助为重点\"},{\"id\":117,\"name\":\"上海科技大学\",\"en_name\":\"ShanghaiTech University\",\"tags\":\"新型大学,研究型大学,双一流,中科院系统单位\",\"ranks\":\"ShanghaiTech University\",\"rank\":48,\"province_id\":3,\"info\":\"上海科技大学于2013年9月30日经教育部批准同意正式建立。2013-2016年，学校与中国科学院大学联合招收了4届硕博连读研究生。2014年，开始招收本科生。从2017年起，学校可独立招收、培养硕士和博士研究生。上海科技大学是一所由上海市人民政府与中国科学院共同举办、共同建设，由上海市人民政府主管，以理工科为主，与中国科学院所属研究院所开展科教融合的全日制普通高等学校。\"},{\"id\":135,\"name\":\"首都医科大学\",\"en_name\":\"Capital Medical University\",\"tags\":\"双一流\",\"ranks\":\"\",\"rank\":49,\"province_id\":1,\"info\":\"首都医科大学建于1956年，原名北京第二医学院；1985年更名为首都医学院；1986年确定为北京市重点院校；1994年更名为首都医科大学；2001年2月12日，北京联合大学中医药学院、北京医学高等专科学校和北京职工医学院并入。首都医科大学是北京市政府、国家卫生健康委员会、教育部三方共建院校。\"},{\"id\":12,\"name\":\"中央民族大学\",\"en_name\":\"Minzu University of China\",\"tags\":\"211,985,双一流\",\"ranks\":\"/,85\",\"rank\":50,\"province_id\":1,\"info\":\"中央民族大学的前身是1941年9月中国共产党创办的延安民族学院。1951年6月，中央民族学院在北京正式成立，乌兰夫任首任院长。1978年被批准为全国重点大学。1993年11月，更名为中央民族大学。1999年，学校成为国家“211工程”重点建设大学，2004年成为国家“985工程”重点建设大学。\"},{\"id\":76,\"name\":\"郑州大学\",\"en_name\":\"Zhengzhou University\",\"tags\":\"211,双一流\",\"ranks\":\"46,57\",\"rank\":50,\"province_id\":15,\"info\":\"郑州大学是国家“211工程”重点建设高校、世界一流大学建设高校和“部省合建”高校。站在新的历史起点上，郑州大学确立了综合性研究型的办学定位，提出了一流大学建设“三步走”发展战略，力争到本世纪中叶建成世界一流综合性研究型大学。\"},{\"id\":19,\"name\":\"中央财经大学\",\"en_name\":\"Central University of Finance and Economics\",\"tags\":\"211,双一流\",\"ranks\":\"/,46\",\"rank\":51,\"province_id\":1,\"info\":\"中央财经大学创建于1949年11月6日，与新中国同龄。学校是教育部直属，教育部、财政部和北京市共建的大学，是国家“双一流”建设、“211工程”建设和首批“优势学科创新平台”项目建设高校。长期以来，学校秉持“忠诚、团结、求实、创新”的校训，传承“求真求是，追求卓越”的办学理念，形成了鲜明的办学特色，为国家经济建设和社会发展培养了14万余名各级各类高素质人才，被誉为“中国财经管理专家的摇篮”。\"},{\"id\":81,\"name\":\"华中师范大学\",\"en_name\":\"Central China Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"47,42\",\"rank\":52,\"province_id\":16,\"info\":\"华中师范大学位于九省通衢的湖北省武汉市，坐落在武昌南湖之滨的桂子山上，占地面积120余万平方米，是教育部直属重点综合性师范大学，国家“211工程”重点建设大学，国家教师教育“985优势学科创新平台”建设高校，首批列入国家“双一流”建设高校，是国家培养中、高等学校师资和其他高级专门人才的重要基地。\"},{\"id\":40,\"name\":\"上海大学\",\"en_name\":\"Shanghai University\",\"tags\":\"211,双一流\",\"ranks\":\"48,64\",\"rank\":53,\"province_id\":3,\"info\":\"上海大学是上海市属、国家“211工程”重点建设的综合性大学，是教育部与上海市人民政府共建高校，上海市首批高水平地方高校建设试点，国家一流学科建设高校。 “文有上大、武有黄埔”，上海大学是中国共产党创办的第一所红色学校，凝聚了一批名师贤达开拓前行，在中国近代教育史和革命史上留下了不可磨灭的篇章。如今，新上海大学赓续红色基因，彰显海派精神，综合实力持续提升，2020年在软科排行榜中挺进全球400强。\"},{\"id\":69,\"name\":\"南京医科大学\",\"en_name\":\"Nanjing Medical University\",\"tags\":\"双一流\",\"ranks\":\"\",\"rank\":54,\"province_id\":4,\"info\":\"南京医科大学是国家“双一流”建设高校，首批教育部、国家卫生健康委与江苏省人民政府共建医学院校，江苏高水平大学建设高峰计划A类建设高校。学校创建于1934年，时名江苏省立医政学院，抗战时期更名为国立江苏医学院。1957年，由镇江迁至南京，更名为南京医学院。1962年，被列为全国首批六年制医药院校。1981年，被批准为全国首批博士、硕士学位授予单位。1993年，更名为南京医科大学。\"},{\"id\":61,\"name\":\"哈尔滨工程大学\",\"en_name\":\"Harbin Engineering University\",\"tags\":\"211,双一流\",\"ranks\":\"49,49\",\"rank\":55,\"province_id\":10,\"info\":\"哈尔滨工程大学前身是创建于1953年的中国人民解放军军事工程学院，俗称“哈军工”。1994年，更名为哈尔滨工程大学；1996年，进入国家首批“211工程”重点建设高校行列；2011年，成为国家“985工程”优势学科创新平台项目建设高校；2017年，进入国家“双一流”建设行列。学校现隶属于工业和信息化部，是我国船舶工业、海军装备、海洋开发、核能应用（“三海一核”）领域重要的人才培养和科学研究基地。\"},{\"id\":105,\"name\":\"西南大学\",\"en_name\":\"Southwest University\",\"tags\":\"211,双一流\",\"ranks\":\"72,41\",\"rank\":55,\"province_id\":21,\"info\":\"西南大学（Southwest University）是教育部直属，教育部、农业农村部、重庆市共建的重点综合大学，是国家首批\\\"双一流\\\"建设高校，\\\"211工程\\\"和\\\"985工程优势学科创新平台\\\"建设高校。学校主体位于重庆市北碚区，是闻名遐迩的花园式学校，教育部表彰的文明校园。\"},{\"id\":185,\"name\":\"南方医科大学\",\"en_name\":\"Southern Medical University\",\"tags\":\"双一流\",\"ranks\":\"\",\"rank\":56,\"province_id\":18,\"info\":\"南方医科大学的前身为中国人民解放军第一军医大学，创建于1951年；1979年确定为全国重点大学；2004年8月整体移交广东省，更名南方医科大学。南方医科大学是广东省高水平大学重点建设高校中唯一的医学院校，全国首批、广东唯一一所教育部、国家卫生健康委员会与广东省共建高校。\"},{\"id\":89,\"name\":\"暨南大学\",\"en_name\":\"Jinan University\",\"tags\":\"211,双一流\",\"ranks\":\"50，50\",\"rank\":57,\"province_id\":18,\"info\":\"素有“华侨最高学府”之称的暨南大学，是中国历史最悠久的大学之一。学校学科齐全，文理工医兼备，师资力量雄厚，综合实力强劲，国际化特色鲜明，校园文化丰富多彩，社团活动精彩纷呈，创新创业氛围浓厚。学校注重以中华优秀传统文化培养造就人才，已形成内地学生、港澳台侨学生、华人及外国留学生三类学生“因材施教、分类培养、同向融合”的培养模式。学校学风浓郁，人才辈出，校友遍布世界各地，“有海水的地方，就有暨南人”。\"},{\"id\":13,\"name\":\"中国政法大学\",\"en_name\":\"China University of Political Science and Law\",\"tags\":\"211,双一流\",\"ranks\":\"/,72\",\"rank\":58,\"province_id\":1,\"info\":\"中国政法大学是一所以法学学科为特色和优势，兼有政治学、经济学、管理学、文学、历史学、哲学、教育学、理学、工学等学科的“211工程”重点建设大学，“‘985工程’优势学科创新平台”“2011计划”和“111计划”（高校学科创新引智计划）重点建设高校，国家“双一流”建设高校，直属于国家教育部，由教育部与北京市共建，正致力于建设世界一流大学和一流学科。\"},{\"id\":47,\"name\":\"南京农业大学\",\"en_name\":\"Nanjing Agricultural University\",\"tags\":\"211,双一流\",\"ranks\":\"51,44\",\"rank\":59,\"province_id\":4,\"info\":\"南京农业大学是一所以农业和生命科学为优势和特色，农、理、经、管、工、文、法学多学科协调发展的教育部直属全国重点大学，国家“211工程”重点建设大学、“985优势学科创新平台”和“双一流”建设高校。学校现有63个本科招生专业、30个硕士授权一级学科、20种专业学位授予权、17个博士授权一级学科和15个博士后流动站。\"},{\"id\":20,\"name\":\"对外经济贸易大学\",\"en_name\":\"University of International Business and Economics\",\"tags\":\"211,双一流\",\"ranks\":\"/,72,1225,\",\"rank\":60,\"province_id\":1,\"info\":\"对外经济贸易大学是教育部直属、国家211工程首批重点建设高校，由教育部和商务部共建，是国家“双一流”建设高校之一。学校目前拥有经、管、法、文、理、工六大学科门类，以国际经济与贸易、法学（国际经济法）、金融学、工商管理、外语（商务外语）等优势专业为学科特色的多科性财经外语类大学。学校坚持复合型、国际化的办学特色，向国家输送大批高素质、创新型、国际化人才，服务国家企业走出去、服务国家“一带一路”倡议。\"},{\"id\":50,\"name\":\"西湖大学\",\"en_name\":\"Westlake University\",\"tags\":\"新型大学\",\"ranks\":\"/,/\",\"rank\":60,\"province_id\":5,\"info\":\"西湖大学是一所社会力量举办、国家重点支持的新型高等学校，前身为浙江西湖高等研究院，由施一公、陈十一、潘建伟、饶毅、钱颖一等发起创办，于2018年2月14日正式获教育部批准设立，举办方是杭州市西湖教育基金会，首任校长由施一公教授担任。学校按照“高起点、小而精、研究型”的办学定位，致力于集聚一流师资、打造一流学科、培育一流人才、产出一流成果，努力为国家科教兴国和创新驱动发展战略作出突出贡献。\"},{\"id\":29,\"name\":\"中国石油大学（北京）\",\"en_name\":\"China University of Petroleum - Beijing\",\"tags\":\"211,双一流\",\"ranks\":\"52,69\",\"rank\":61,\"province_id\":1,\"info\":\"中国石油大学（北京）是国家“211工程”重点建设、“优势学科创新平台”建设和“双一流”学科建设高校。学校一校两区（北京、克拉玛依），两校区独立招生，录取互不调剂。北京校区2020年面向全国招收2300人，设有21个本科招生专业（类），涵盖32个本科专业；学校重视人才培养，拥有32个一级学科硕士点，14个一级学科博士点，推行“本博/本硕一体化”“转专业”“双学位”“国际联合培养”等人才培养模式。\"},{\"id\":58,\"name\":\"东北师范大学\",\"en_name\":\"Northeast Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"53,56\",\"rank\":62,\"province_id\":9,\"info\":\"东北师范大学是教育部直属高校，国家“211工程”重点建设大学，教师教育“985工程”优势学科创新平台建设高校，国家“双一流”建设高校。学校坐落在美丽的北国春城长春市。学校原名东北大学，建校于1946年，是中国共产党在东北地区创建的第一所综合性大学。学校已逐步建设成为涵盖哲学、经济学、法学、教育学、文学、历史学、理学、工学、农学、管理学、艺术学等十一个学科门类的综合性、研究型大学。\"},{\"id\":79,\"name\":\"武汉理工大学\",\"en_name\":\"Wuhan University of Technology\",\"tags\":\"教育部直属/理工/双一流/211工程\",\"ranks\":\"54,34\",\"rank\":63,\"province_id\":16,\"info\":\"武汉理工大学是教育部直属全国重点大学，是首批列入国家“211工程”和“双一流”建设高校，是教育部和交通运输部等部委共建高校。学校办学历史起源于1898年建立的湖北工艺学堂，办学122年特别是近70年来，学校共培养了60余万名高级专门人才，是教育部直属高校中为建材建工、交通、汽车三大行业培养人才规模最大的学校。学校已形成以工学为主，理、工、经、管、艺术、文、法等多学科相互渗透协调发展的学科专业体系。\"},{\"id\":95,\"name\":\"西南交通大学\",\"en_name\":\"Southwest Jiaotong University\",\"tags\":\"211,双一流\",\"ranks\":\"55,52\",\"rank\":64,\"province_id\":19,\"info\":\"西南交通大学的前身为创建于1896年的山海关北洋铁路官学堂，是中国第一所工程教育高等学府，也是“交通大学”的最早两大源头之一。1952年，学校部分系科师资调入清华大学、天津大学等兄弟院校；1964年内迁四川；1972年更名西南交通大学。西南交通大学为教育部直属高校，是教育部和四川省共建的全国重点大学。\"},{\"id\":48,\"name\":\"中国矿业大学（徐州）\",\"en_name\":\"China University of Mining and Technology - Xuzhou\",\"tags\":\"211,双一流\",\"ranks\":\"56,73\",\"rank\":65,\"province_id\":4,\"info\":\"中国矿业大学创办于1909年，是教育部直属的全国重点高校、国家“211工程”“985平台”和国家“双一流”建设高校。是全国首批具有博士和硕士授予权的高校之一，设有研究生院。坐落于国家历史文化名城——江苏徐州。在第四轮学科评估中，两个学科全国排名第一，电气、计算机、机械、数学等学科均位于全国前列。工程学、地球科学、材料科学、化学、数学、环境科学和计算机科学7个学科进入全球大学和科研机构的前1%。\"},{\"id\":91,\"name\":\"香港中文大学（深圳）\",\"en_name\":\"The Chinese University of Hong Kong, Shenzhen\",\"tags\":\"中外合作办学\",\"ranks\":\"\",\"rank\":67,\"province_id\":18,\"info\":\"香港中文大学（深圳）是一所经国家教育部批准，按中外合作办学条例设立的大学。大学以创建一所立足中国、面向世界的一流研究型大学为己任，致力于培养具有国际视野、中华传统和社会担当的创新型高层次人才。目前，来自世界各地的7000多名优秀学子正在港中大（深圳）求学。\"},{\"id\":5,\"name\":\"南京师范大学\",\"en_name\":\"Nanjing Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"\",\"rank\":68,\"province_id\":4,\"info\":\"南京师范大学是国家“双一流”建设高校和江苏高水平大学建设高校，中国高等师范教育的发祥地之一，大批优质师资在此教书育人。随园校区有着“东方最美的校园”美誉之称。学校目前拥有国家“双一流”建设学科1个（地理学）、9个国家重点及培育学科，6个学科入选全国第四轮学科评估A类学科，A类学科数位列全国地方高校第1位，全国高校第34位，9个学科跻身ESI全球前1%。学校正在着力建设“有国际影响的高水平大学”。\"},{\"id\":83,\"name\":\"中国地质大学（武汉）\",\"en_name\":\"China University of Geosciences (Wuhan) \",\"tags\":\"211,双一流\",\"ranks\":\"59,69\",\"rank\":69,\"province_id\":16,\"info\":\"中国地质大学创建于1952年，前身是北京大学、清华大学、天津大学、唐山铁道学院等院校的地质系（科）合并组建而成的北京地质学院。1987年，国家教育委员会批准组建中国地质大学。 中国地质大学是教育部直属全国重点大学, 是国家批准设立研究生院的大学，是国家“211工程”、国家“双一流”建设高校。中国地质大学位于武汉东湖之畔，南望山麓，学校以地球科学为主要特色，学科涵盖理学、工学、文学、管理学、经济学、法学、教育学、艺术学等门类，地质学、地质资源与地质工程2个一级学科入选“双一流”建设学科。 中国科学院院士11人，博士生导师310人，教授520人，副教授927人。学校现有各类科研机构、实验室、研究院（所、中心）86个，其中国家重点实验室2个。现有2个国家一级重点学科，16个湖北省重点学科，“地质学”、“地质资源与地质工程” 两个一级学科在全国历次学科评估中均排名第一；有23个学院（所）、65个本科专业；有16个一级学科博士点，34个一级学科硕士点，15个博士后科研流动站。 近五年毕业生年终就业率超过 96%，保研率超过19%，升学出国率超过45%。\"},{\"id\":67,\"name\":\"江南大学\",\"en_name\":\"Jiangnan University\",\"tags\":\"211,双一流\",\"ranks\":\"60,55\",\"rank\":70,\"province_id\":4,\"info\":\"江南大学是教育部直属、国家“211工程”重点建设高校和双一流建设高校，是一所在国内有影响力、国际有知名度的特色鲜明的高水平研究型大学。江南大学源起1902年创建的三江师范学堂，于1958年建校，坐落于江苏省无锡市。学校现有18个学院（部），53个本科招生专业，涵盖理、工、医、文、法、经济、管理、教育、艺术等9个学科门类。占地面积3250亩，曾获教育部校园规划一等奖，被誉为“中国最美丽的大学”之一。\"},{\"id\":45,\"name\":\"河海大学\",\"en_name\":\"Hohai University\",\"tags\":\"211,双一流\",\"ranks\":\"61,39\",\"rank\":71,\"province_id\":4,\"info\":\"经过百余年砥砺前行，河海大学已发展成为以水利为特色，工科为主，多学科协调发展的教育部直属全国重点大学。教育部直属全国重点大学；教育部、水利部、国家海洋局与江苏省共建高校；“211工程”、“985工程”优势学科创新平台建设高校；国家“双一流”建设高校长期以来，学校着力培养具有“中国灵魂、全球视野、河海特质”的一流人才，谱写了“哪里有水，哪里就有河海人；哪里有水，哪里就有河海大学作出的贡献”美丽佳话。\"},{\"id\":74,\"name\":\"中国海洋大学\",\"en_name\":\"Ocean University of China\",\"tags\":\"211,985,双一流\",\"ranks\":\"62,38\",\"rank\":72,\"province_id\":14,\"info\":\"中国海洋大学是一所海洋和水产学科特色显著、学科门类齐全的教育部直属重点综合性大学，是国家“211工程”和“985工程”重点建设的高校，是国家“世界一流大学建设高校”（A类）。学校依山傍海，坐落在景色秀丽、气候宜人的海滨城市青岛。 学校始建于1924年，是国人在齐鲁大地上创办的第一所本科起点的现代意义上的高等学府,历史上，闻一多、梁实秋、老舍等一大批学界名人曾在此治学育人。 学校以造就国家海洋事业的领军人才和骨干力量为特殊使命，遵循“通识为体，专业为用”的本科教育理念，实行有限条件的自主选课制度和学业识别与毕业专业识别确认制度，努力培养复合型、高素质人才。 建校以来，毕业生中已有14人当选中国科学院或中国工程院院士，一批批国家海洋事业的领军人才和骨干力量从中国海洋大学走出，他们中有“南沙守礁卫士”李文波、中国载人航天工程零号指挥员王洪志……“神舟”飞天、“嫦娥”奔月、“蛟龙”探海、极地科考、亚丁湾护航、辽宁舰入列、南海守礁、蓝色经济蓬勃发展——这其中无不闪现着海大人的身影。 欢迎莘莘学子加入中国海洋大学，投身建设海洋强国事业的蓝色华章。\"},{\"id\":17,\"name\":\"北京工业大学\",\"en_name\":\"Beijing University of Technology\",\"tags\":\"211,双一流\",\"ranks\":\"63,69\",\"rank\":73,\"province_id\":1,\"info\":\"北京工业大学创建于1960年；1972年以来，北京工商管理专科学校、原北京联合大学经济管理学院、北京计算机学院、北京艺术设计学院等先后并入。北京工业大学隶属于北京市人民政府，是北京市与教育部共建的重点大学。\"},{\"id\":18,\"name\":\"北京化工大学\",\"en_name\":\"Beijing University of Chemical Technology\",\"tags\":\"211,双一流\",\"ranks\":\"64,64\",\"rank\":75,\"province_id\":1,\"info\":\"北京化工大学创办于1958年，原名北京化工学院，是为“培养尖端科学技术所需求的高级化工人才”而创建的一所高水平大学；1994年更名为北京化工大学。北京化工大学为教育部直属高校，是教育部与北京市人民政府、国家国防科技工业局、国家安全生产监督管理总局和中国石油化工集团公司共建的全国重点大学。\"},{\"id\":101,\"name\":\"西北大学\",\"en_name\":\"Northwest University\",\"tags\":\"211,双一流\",\"ranks\":\"65,58\",\"rank\":76,\"province_id\":20,\"info\":\"西北大学是首批国家“世界一流学科建设高校”、国家“211工程”建设院校、教育部与陕西省共建高校。现有24个院（系）和研究生院，具有学士、硕士、博士学位及专业学位授予权，设有博士后科研流动站。在百余年的办学历程中，西北大学走出了28 位两院院士（中国科学院院士22 位、中国工程院院士6 位）；4 位中国科学院哲学社会科学部学部委员，8 位国际科研机构院士。\"},{\"id\":94,\"name\":\"西南财经大学\",\"en_name\":\"Southwestern University of Finance and Economics\",\"tags\":\"211,双一流\",\"ranks\":\"/,75\",\"rank\":77,\"province_id\":19,\"info\":\"西南财经大学是教育部直属的国家“211工程”和“985工程”优势学科创新平台建设的全国重点大学，也是国家首批“双一流”建设高校。学校坐落于中国历史文化名城——“天府之国”成都，有光华、柳林两校区，辖地2300余亩。校园湖光柳影，芳草绿树，翩翩学者，蔚为大观，是著名的“园林式院校”，实乃读书治学的理想园地。\"},{\"id\":68,\"name\":\"中国药科大学\",\"en_name\":\"China Pharmaceutical University\",\"tags\":\"211,双一流\",\"ranks\":\"/,96\",\"rank\":78,\"province_id\":4,\"info\":\"中国药科大学，坐落于六朝古都南京，是中国第一所由国家创办的药学高等学府，是教育部直属、国家“211工程”和国家“双一流”建设的全国重点高校。药学特色学科群建设始终保持国内领先水平，国家一级重点学科“药学”学科为A+学科，中药学学科入选国家“双一流”建设学科；六个学科领域的ESI排名进入全球前1%。毕业生备受用人单位青睐，就业率连续多年位居教育部和江苏省高校前列。\"},{\"id\":75,\"name\":\"中国石油大学（华东）\",\"en_name\":\"China University of Petroleum (Huadong)\",\"tags\":\"211,双一流\",\"ranks\":\"66,81\",\"rank\":78,\"province_id\":14,\"info\":\"中国石油大学（华东）是教育部直属并建有研究生院的全国重点大学，是国家“双一流”建设高校、“211工程”和“985工程优势学科创新平台”建设高校。2017年石油与天然气工程、地质资源与地质工程2个一级学科入选国家“双一流”建设计划。在第四轮学科评估中，我校有22个学科榜上有名，6个一级学科进入全国前十名，其中A+学科数量排名全国第22位。2019年，学校一半以上专业进入首批一流专业“双万计划”。\"},{\"id\":102,\"name\":\"陕西师范大学\",\"en_name\":\"Shaanxi Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"67,73\",\"rank\":79,\"province_id\":20,\"info\":\"陕西师范大学是教育部直属、世界一流学科建设高校，国家“211工程”重点建设大学，是培养高等院校、中等学校师资和教育管理干部以及其他高级专门人才的重要基地，被誉为“教师的摇篮”。建校70多年来，学校秉承“西部红烛精神”和“厚德、积学、励志、敦行”的优良传统，立足西部，服务全国，已发展成为一所有重要影响的综合性一流师范大学，为国家培养各类毕业生47.1万余。\"},{\"id\":72,\"name\":\"南昌大学\",\"en_name\":\"Nanchang University\",\"tags\":\"211,双一流\",\"ranks\":\"69，67\",\"rank\":81,\"province_id\":13,\"info\":\"南昌大学是国家“双一流”计划世界一流学科建设高校、教育部与江西省部省合建高校、国家“211工程”重点建设高校、江西省高水平大学整体建设高校。学校围绕立德树人根本任务，牢固树立人才培养的中心地位、教育教学的基础地位和本科教学的优先地位。对接教育部“双万”计划，获批39个国家级一流本科专业建设点、39个省级一流本科专业建设点。30门课程入选国家“一流课程”，总数位居部省合建高校首位。\"},{\"id\":153,\"name\":\"天津医科大学\",\"en_name\":\"Tianjin Medical University\",\"tags\":\"211,双一流\",\"ranks\":\"/,103\",\"rank\":81,\"province_id\":2,\"info\":\"天津医科大学创建于1951年，是国家“世界一流学科建设高校”、“211工程”重点建设院校，天津市人民政府、国家卫生健康委员会和教育部共建高校。办学历史悠久，是国家最早批准试办八年制的2所医学院校之一、首批试办七年制的15所院校之一。学校积极投身于我国医学高等教育事业，坚持教育教学为立校之本，科学研究为强校之路，以学生为本、致力于办人民满意的教育，为国家及天津市医药卫生行业培养了大批高素质医学人才。\"},{\"id\":80,\"name\":\"中南财经政法大学\",\"en_name\":\"Zhongnan University of Economics and Law\",\"tags\":\"211,双一流\",\"ranks\":\"/,51\",\"rank\":82,\"province_id\":16,\"info\":\"中南财经政法大学，学校前身是1948年创建的中原大学。2000年，中南财经大学和中南政法学院合并，组建了新的中南财经政法大学。学校是中华人民共和国教育部直属的一所以经济学、法学、管理学为主干，兼有哲学、文学、史学、理学、工学、艺术学等九大学科门类的普通高等学校，是国家“211工程”高校和“985工程优势学科创新平台”项目重点建设高校，是教育部、财政部、湖北省人民政府共建高校，入选世界一流大学和一流学科（简称“双一流”）建设高校及建设学科名单。\"},{\"id\":26,\"name\":\"中国地质大学（北京）\",\"en_name\":\"China University of Geosciences (Beijing)\",\"tags\":\"211,双一流\",\"ranks\":\"71,104\",\"rank\":83,\"province_id\":1,\"info\":\"中国地质大学（北京）坐落于名校荟萃的北京海淀区学院路，是教育部直属并与自然资源部共建的全国重点大学，是我国首批试办研究生院的33所高校之一，首批“211工程”建设大学，“985”优势学科创新平台建设高校，2017年进入国家“双一流”大学建设行列。现有16个学院、42个本科专业（方向）正在招生，18个一级学科博士学位授权点，34个一级学科硕士学位授权点，14个专业学位授权类别。\"},{\"id\":71,\"name\":\"福州大学\",\"en_name\":\"Fuzhou University\",\"tags\":\"211,双一流\",\"ranks\":\"73，75\",\"rank\":85,\"province_id\":12,\"info\":\"福州大学是国家“双一流”建设高校、国家“211工程”重点建设大学、福建省人民政府与国家教育部共建高校。学校创建于1958年，现已发展成为一所以工为主、理工结合，理、工、经、管、文、法、艺等多学科协调发展的重点大学。\"},{\"id\":99,\"name\":\"西北农林科技大学\",\"en_name\":\" Northwest A&F University\",\"tags\":\"211,985,双一流\",\"ranks\":\"74,54\",\"rank\":86,\"province_id\":20,\"info\":\"教育部直属全国重点大学，国家“985工程“和“211工程“重点建设高校，国家“双一流”建设高校。 9个学科进入全球ESI学科排名前1%，2个学科进入ESI前1‰，25个专业入选国家级一流本科专业建设点，9个专业入选省级一流本科专业建设点。 学校围绕保障国家粮食安全、生态文明、人类健康、乡村振兴四大学科使命，支撑和引领未来农业发展。\"},{\"id\":23,\"name\":\"华北电力大学（北京）\",\"en_name\":\"North China Electric Power University\",\"tags\":\"211,双一流\",\"ranks\":\"75,113,57,739,1201\",\"rank\":87,\"province_id\":1,\"info\":\"华北电力大学是教育部直属全国重点大学，国家“211工程”和“985工程优势学科创新平台”重点建设大学。学校进入国家“双一流”建设高校行列，电气工程入选第二轮“双一流”建设学科。学校现由国家电网有限公司等12家特大型电力集团和中国电力企业联合会组成的理事会与教育部共建。校部设在北京，分设保定校区，两地实行一体化管理。本科招生按照华北电力大学(10054)和华北电力大学(保定)(10079)分别录取。\"},{\"id\":27,\"name\":\"中国矿业大学（北京）\",\"en_name\":\"China University of Mining and Technology - Beijing\",\"tags\":\"211,双一流\",\"ranks\":\"76,108\",\"rank\":88,\"province_id\":1,\"info\":\"中国矿业大学（北京）是教育部直属全国重点高校、211工程、985优势学科创新平台项目、世界一流学科建设高校、全国首批产业技术创新战略联盟高校。1960年和1978年学校先后两次被确定为全国重点高校，为全国首批具有博士和硕士授予权的高校之一，设有研究生院和12个学院。学校在能源勘探、开发、利用，资源、环境和生产相关的矿建、安全、测绘、机械、信息技术、生态恢复、管理工程等领域形成了优势品牌和鲜明特色。\"},{\"id\":42,\"name\":\"东华大学\",\"en_name\":\"Donghua University\",\"tags\":\"211,双一流\",\"ranks\":\"77,62\",\"rank\":88,\"province_id\":3,\"info\":\"东华大学是教育部直属、国家“211工程”、国家“双一流”建设高校。建校七十年来，学校秉承“崇德博学、砺志尚实”的校训，不断开拓奋进，已发展成为以纺织、材料、服装、设计为优势，特色鲜明的多科性、高水平大学。\"},{\"id\":177,\"name\":\"华南师范大学\",\"en_name\":\"South China Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"79，62\",\"rank\":89,\"province_id\":18,\"info\":\"华南师范大学始建于1933年，前身是广东省立勷勤大学师范学院。是国家“211工程”重点建设大学、省部共建高校、广东省高水平大学整体建设高校和国家“一流学科”建设高校。入选国家“111计划”“卓越教师培养计划”、国家级大学生创新创业训练计划、国家建设高水平大学公派研究生项目、国家大学生文化素质教育基地等，为中国人工智能教育联席会理事单位。学校现有广州石牌、广州大学城、佛山南海和汕尾4个校区。\"},{\"id\":107,\"name\":\"云南大学\",\"en_name\":\"Yunnan University\",\"tags\":\"211,双一流\",\"ranks\":\"80,56\",\"rank\":90,\"province_id\":23,\"info\":\"云南大学始建于1922年，时为私立东陆大学，1934年更名为省立云南大学，1938年改为国立云南大学。1946年，《不列颠百科全书》将云南大学列为中国15所世界著名大学之一。1978年，云南大学被国务院确定为全国88所重点大学之一。1996年首批列入国家“211工程”重点建设大学，2017年成为中国首批42所“一流大学”建设高校之一，2018年跻身于中西部14所“以部为主、部省合建”高校行列。\"},{\"id\":21,\"name\":\"北京外国语大学\",\"en_name\":\"Beijing Foreign Studies University\",\"tags\":\"211,双一流\",\"ranks\":\"79,/,180\",\"rank\":91,\"province_id\":1,\"info\":\"北京外国语大学的前身为1941年于延安创办的中国抗日军政大学三分校俄文队，后发展为延安外国语学校；1954年更名为北京外国语学院；1959年与北京俄语学院合并，组建新的北京外国语学院；1994年正式定名为北京外国语大学。北京外国语大学是中国共产党创办的第一所外国语高等学校，是教育部直属的全国重点大学。\"},{\"id\":25,\"name\":\"北京林业大学\",\"en_name\":\"Beijing Forestry University\",\"tags\":\"211,双一流\",\"ranks\":\"82,78\",\"rank\":92,\"province_id\":1,\"info\":\"北京林业大学，隶属于国家教育部，是国家首批“211工程”重点建设高校和国家“优势学科创新平台”建设项目试点高校，是世界一流学科建设高校。学校以生物学、生态学为基础，以林学、风景园林学、林业工程、草学和农林经济管理为特色，是农、理、工、管、经、文、法、哲、教、艺等多门类协调发展的全国重点大学。\"},{\"id\":22,\"name\":\"中国传媒大学\",\"en_name\":\"Communication University of China\",\"tags\":\"211,双一流\",\"ranks\":\"84,/,/,/,/\",\"rank\":93,\"province_id\":1,\"info\":\"中国传媒大学的前身是创建于1954年的中央广播事业局技术人员训练班；1958年更名为北京广播专科学校；1959年经国务院批准升格为北京广播学院；2000年由国家广播电影电视总局划转教育部管理；2002年中国矿业大学北京校区东校园整体并入；2004年更名为中国传媒大学，是教育部直属的信息传播领域行业特色大学，国家“世界一流学科建设高校”、“211工程”重点建设大学，“985工程优势学科创新平台”重点建设高校。\"},{\"id\":66,\"name\":\"合肥工业大学\",\"en_name\":\"Hefei University of Technology\",\"tags\":\"211,双一流\",\"ranks\":\"83,47\",\"rank\":94,\"province_id\":11,\"info\":\"合肥工业大学的前身是1945年创建的安徽省立蚌埠高级工业职业学校，先后历经安徽省立工业专科学校、合肥矿业学院等发展阶段；1958年更名为合肥工业大学；1969年安徽水利电力学院和安徽工学院并入。后农机系等单位分出并成立为安徽农机学院，1979年安徽农机学院更名为安徽工学院。1997年原合肥工业大学与安徽工学院合并组建新的合肥工业大学。合肥工业大学隶属于教育部，是教育部、工业和信息化部、安徽省人民政府共建的全国重点大学。\"},{\"id\":24,\"name\":\"北京中医药大学\",\"en_name\":\"Beijing University of Chinese Medicine\",\"tags\":\"211,双一流\",\"ranks\":\"/,101,128,1489,801-1000\",\"rank\":95,\"province_id\":1,\"info\":\"北京中医药大学是一所以中医药学为主干学科的全国重点大学，直属教育部管理，由教育部、国家卫生健康委员会、国家中医药管理局和北京市共建。学校始建于1956年，前身为北京中医学院，是国务院批准最早创办的高等中医药院校。学校致力于构建面向未来以高层次教育为主的人才培养体系，目前设有中医学、中药学、中药制药、药学、针灸推拿学、康复治疗学等12个本科招生专业。\"},{\"id\":86,\"name\":\"湖南师范大学\",\"en_name\":\"Hunan Normal University\",\"tags\":\"211,双一流\",\"ranks\":\"87,57\",\"rank\":96,\"province_id\":17,\"info\":\"湖南师范大学前身为1938年创立的中国第一所独立设置的国立师范学院；中华人民共和国成立之初，国立师范学院并入湖南大学；全国院系调整时，撤销湖南大学，建立了湖南师范学院；1984年，学校更名为湖南师范大学。湖南师范大学是教育部与湖南省共建的国家“双一流”建设高校。\"},{\"id\":100,\"name\":\"长安大学\",\"en_name\":\"Chang'an University\",\"tags\":\"211,双一流\",\"ranks\":\"88,93\",\"rank\":97,\"province_id\":20,\"info\":\"长安大学坐落于历史文化名城西安。长安大学是教育部直属全国重点大学，国家首批“211工程”重点建设大学、国家“985优势学科创新平台”建设高校、国家“双一流”建设高校，是教育部与交通运输部、自然资源部、住房和城乡建设部、陕西省人民政府四部一省共建高校，是我国交通运输、国土资源、城乡建设三大行业高层次人才培养、高水平科学研究、高质量社会服务的重要基地。\"},{\"id\":120,\"name\":\"中国社科院大学\",\"en_name\":\"University of Chinese Academy of Social Sciences\",\"tags\":\"211,985,双一流\",\"ranks\":\"/,/\",\"rank\":98,\"province_id\":1,\"info\":\"中国社会科学院大学（简称中国社科大 )，英文名称University Of Chinese Academy Of Social Sciences (UCASS)，校训“笃学、慎思、明辨、尚行”，以中国社会科学院研究生院为基础，整合中国青年政治学院本科教育及部分研究生教育资源而组建，以马克思主义为指导，坚持党的领导，坚持正确的办学方向，坚持中国特色社会主义大学的办学方针，致力培养政治可靠、作风过硬、理论深厚、学术精湛的哲学社会科学后备人才，培养又红又专、德才兼备、全面发展的中国特色社会主义事业接班人和建设者，努力建设成为具有中国特色的社会主义一流文科大学。\"},{\"id\":39,\"name\":\"上海外国语大学\",\"en_name\":\"Shanghai International Studies University\",\"tags\":\"211,双一流\",\"ranks\":\"97,112\",\"rank\":100,\"province_id\":3,\"info\":\"上海外国语大学起源于1949年成立的华东人民革命大学附设上海俄文学校；后经上海俄文专修（科）学校阶段，于1956年学校更名为上海外国语学院；1958年上海第一师范学院外语系英语专业并入；1994年正式更名为上海外国语大学。上海外国语大学现为教育部直属高校，是教育部和上海市人民政府共建的全国重点大学。\"},{\"id\":407,\"name\":\"中国疾控中心\",\"en_name\":\"China Center for Disease Control and Prevention\",\"tags\":\"中国疾病预防控制中心\",\"ranks\":\"\",\"rank\":100,\"province_id\":0,\"info\":\"根据《中央编办关于中国疾病预防控制中心等单位划转国家疾控局管理的批复》（中编办复字〔2022〕89号），中国疾病预防控制中心由国家卫生健康委划转国家疾控局管理，为国家疾控局直属事业单位。　中国疾病预防控制中心从1984年开始独立招收和培养研究生。中心现有基础医学、公共卫生与预防医学2个一级学科博士硕士学位授予点，免疫学、病原生物学、放射医学、流行病与卫生统计学、劳动卫生与环境卫生学、营养与食品卫生学、少儿卫生与妇幼保健学、卫生毒理学等8个二级学科博士硕士学位授予点，以及公共卫生硕士（MPH）专业学位授予点，其中病原生物学为北京市重点学科。截至2022年11月，现有两院院士5人，研究生导师共412人，其中博士生导师107人，硕士生导师178人，MPH 导师127人，聘任研究生副导师448人。在读研究生903人（全日制博士生264人、学术型硕士生277人、MPH硕士生362人）。\"},{\"id\":55,\"name\":\"大连海事大学\",\"en_name\":\"Dalian Maritime University\",\"tags\":\"211,双一流\",\"ranks\":\"99,124\",\"rank\":101,\"province_id\":8,\"info\":\"大连海事大学（原大连海运学院）是交通运输部所属的全国重点大学，是国家“211工程”重点建设高校、国家“双一流”建设高校，是交通运输部、教育部、国家海洋局、国家国防科技工业局、辽宁省人民政府、大连市人民政府共建高校。学校素有“航海家的摇篮”之称，是中国著名的高等航海学府，是被国际海事组织认定的世界上少数几所“享有国际盛誉”的海事院校之一。\"},{\"id\":65,\"name\":\"安徽大学\",\"en_name\":\"Anhui University\",\"tags\":\"211,双一流\",\"ranks\":\"104,87\",\"rank\":102,\"province_id\":11,\"info\":\"安徽大学创建于1928年当时的省会安庆市，1949年迁至芜湖，1956年迁建合肥市。在中华人民共和国成立初期的院系调整过程中，安徽大学先后整合了复旦大学、南京大学、金陵大学、江苏师院、合肥师范学院等高校部分系科，并在世纪之交时将安徽银行学校、安徽财政学校等院校并入。安徽大学隶属于安徽省人民政府，是安徽省与教育部共建的省属重点综合性大学。\"},{\"id\":52,\"name\":\"太原理工大学\",\"en_name\":\"Taiyuan University of Technology\",\"tags\":\"211,双一流\",\"ranks\":\"107,97\",\"rank\":103,\"province_id\":7,\"info\":\"太原理工大学是一所历史悠久、底蕴深厚、特色鲜明的世纪学府。其前身是创立于1902年的山西大学堂西学专斋，为中国创办最早的三所国立大学之一，坐落于具有2500多年建城史的国家历史文化名城——太原。1953年，学校独立建校，定名太原工学院，直属高等教育部；1962年划归山西省管理；1984年更名为太原工业大学。1997年，太原工业大学与直属于国家煤炭工业部的山西矿业学院（始建于1958年）合并，组建太原理工大学，同年跻身国家“211工程”重点建设高校行列，开启了改革发展的新篇章。2017年，学校入选国家“双一流”重点建设高校，迎来了崭新的发展时期。\"},{\"id\":118,\"name\":\"华东政法大学\",\"en_name\":\"East China University of Political Science and Law\",\"tags\":\"双一流\",\"ranks\":\"/,120\",\"rank\":103,\"province_id\":3,\"info\":\"华东政法大学原名为华东政法学院，1952年6月由圣约翰大学、复旦大学、南京大学、东吴大学、厦门大学、沪江大学、安徽大学、上海学院、震旦大学9所院校的法律系、政治系和社会系在圣约翰大学旧址合并成立；1958年并入上海社会科学院；1963年再次筹建；1966年停止招生，1972年被撤销；1979年3月第二次复校；2007年3月更名为华东政法大学。华东政法大学是中华人民共和国创办的第一批高等政法院校之一，为教育部与上海市共建的上海市高水平地方高校。\"},{\"id\":106,\"name\":\"贵州大学\",\"en_name\":\"Guizhou University\",\"tags\":\"211,双一流\",\"ranks\":\"109,87\",\"rank\":104,\"province_id\":22,\"info\":\"贵州大学创建于1902年，历经贵州大学堂、省立贵州大学、国立贵州农工学院、国立贵州大学等时期，1950年10月定名为贵州大学。1951年11月，毛泽东主席亲笔题写“贵州大学”校名。1997年8月，与贵州农学院等院校合并。2004年8月，与贵州工业大学合并。2004年12月，成为教育部与贵州省人民政府共建高校。2005年9月，成为国家“211工程”大学。2017年9月，成为国家世界一流学科建设高校。\"},{\"id\":114,\"name\":\"广西大学\",\"en_name\":\"Guangxi University\",\"tags\":\"211,双一流\",\"ranks\":\"96,121\",\"rank\":105,\"province_id\":29,\"info\":\"广西大学是广西办学历史最悠久、规模最大的综合性大学，是“211工程”高校，世界一流学科建设高校，“部区合建”高校。在九十多年的办学历程中，广西大学虽经历了数次院系合并、调整，始终抱定“保卫中华、发达广西”的宗旨，秉持“勤恳朴诚，厚学致新”的校训，发扬“学生拼命学、老师拼命教、员工拼命干”的三拼精神，积淀了鲜明的办学特色、深厚的人文底蕴和独特的西大精神。西大师生根植八桂，为谱写新时代富民兴桂的壮美华章而不懈奋斗。\"},{\"id\":240,\"name\":\"南京工业大学\",\"en_name\":\"Nanjing Tech University\",\"tags\":\"南京,理工类,2011计划\",\"ranks\":\"85,85,/,618,82,85\",\"rank\":105,\"province_id\":4,\"info\":\"南京工业大学具有百年办学历史，是首批入选国家“高等学校创新能力提升计划”（2011计划）的14所高校之一，是江苏高水平大学建设高峰计划A类高校，ESI综合排名位列中国内地高校第56位。学校学科覆盖广泛，91个本科专业中23个工科专业跻身全球工程教育“第一方阵”，同时拥有24个国家级、6个省级一流本科专业建设点。学校为社会输送了大批高质量人才，培育了10多位省部级以上领导干部、20位“两院”院士、50多位央企和上市公司领导。\"},{\"id\":28,\"name\":\"北京体育大学\",\"en_name\":\"Beijing Sport University\",\"tags\":\"211,双一流\",\"ranks\":\"/,116\",\"rank\":115,\"province_id\":1,\"info\":\"北京体育大学成立于1953年，原名中央体育学院，1956年更名为北京体育学院，1993年更名为北京体育大学，是全国重点院校、国家“211工程”重点建设大学、国家首批“双一流”建设高校，具有光荣的办学历史、深厚的文化底蕴和扎实的办学基础，在国内外享有盛誉，隶属国家体育总局。学校位于海淀区信息路，占地面积75.5万平方米，建筑面积约41万平方米，共拥有室内外训练场馆近100个。\\n\\n学校现设有体育与健康学部、人文社科学部、奥林匹克运动学部、体育工程学部4个学部，体育与健康学部下设教育学院（体育师范学院）、心理学院等7个学院；人文社科学部下设马克思主义学院、管理学院等8个学院；奥林匹克运动学部下设中国足球运动学院（中国足球教练员学院）、中国篮球运动学院等9个学院（校）；体育工程学部下设体育工程学院。中共国家体育总局党校、国家体育总局干部培训中心、国家体育总局教练员学院设在学校。\"},{\"id\":136,\"name\":\"首都师范大学\",\"en_name\":\"Capital Normal University\",\"tags\":\"双一流\",\"ranks\":\"89,74\",\"rank\":116,\"province_id\":1,\"info\":\"首都师范大学创建于1954年，原名北京师范学院，办学历史可追溯至1905年成立的通州师范；1960年后，华北人民大学、北京工农师范学院、北京艺术师范学院、北京师范专科学校等部分院系先后并入；1992年，北京师范学院分院并入，同年更名为首都师范大学。首都师范大学是教育部与北京市人民政府共建高校。\"},{\"id\":241,\"name\":\"南京林业大学\",\"en_name\":\"Nanjing Forestry University\",\"tags\":\"农林类,双一流\",\"ranks\":\"110,79\",\"rank\":117,\"province_id\":4,\"info\":\"南京林业大学坐落于风景秀丽的紫金山麓、碧波荡漾的玄武湖畔，是中央与地方共建的省属重点高校，于2017年入选国家“双一流”建设高校名单。学校前身为中央大学（创建于1902年）森林系和金陵大学（创建于1910年）森林系，1952年合并组建的南京林学院，是当时全国仅有的三所高等林业院校之一。1955年华中农学院林学系（武汉大学、南昌大学和湖北农学院森林系合并组成）并入；1972年更名为南京林产工业学院；1983年恢复南京林学院名称；1985年更名为南京林业大学。作为一所以林科为特色，以资源、生态和环境类学科为优势的多科性大学。\"},{\"id\":115,\"name\":\"海南大学\",\"en_name\":\"Hainan University\",\"tags\":\"211,双一流\",\"ranks\":\"118,141\",\"rank\":118,\"province_id\":30,\"info\":\"海南大学是于2007年8月由原华南热带农业大学与原海南大学合并组建而成的综合性重点大学。原华南热带农业大学创建于1958年，与创建于1954年的中国热带农业科学院紧密结合，并称“热作两院”，被誉为我国热带农业科教领域的“双子星”。原海南大学于1983年在一片荒滩地上艰苦起家。2008年12月，学校经国家批准成为“211工程”重点建设高校；2012年跻身“中西部高等教育振兴计划”建设行列；2017年入选国家世界一流学科建设高校；2018年成为教育部与海南省政府部省合建高校。现在的海南大学已经发展成为国家重点建设、对区域经济社会发展影响广泛的综合性大学，建立了海南省规模最大、学科相对齐全的本科、硕士、博士一体化人才培养体系。\"},{\"id\":96,\"name\":\"四川农业大学\",\"en_name\":\"Sichuan Agricultural University\",\"tags\":\"211,双一流\",\"ranks\":\"142,109\",\"rank\":119,\"province_id\":19,\"info\":\"四川农业大学是一所具有百年历史，多学科协调发展的国家“211工程”重点建设大学和国家“双一流”建设高校，也是教育部本科教学工作水平评估优秀高校。有雅安、成都和都江堰3个校区，学院27个，研究所(中心)15个，国家重点实验室1个。学校教学科研成果丰硕，获国家级教学成果奖、国家技术发明奖、国家自然科学奖、国家科技进步奖等国家级大奖数量位列全国高校前列。近年来毕业生就业工作居全国前列，就业率90%左右。\"},{\"id\":62,\"name\":\"东北农业大学\",\"en_name\":\"Northeast Agricultural University - China\",\"tags\":\"211,双一流\",\"ranks\":\"120,104\",\"rank\":120,\"province_id\":10,\"info\":\"东北农业大学是一所以农科为优势，以生命科学和食品科学为特色，农、工、理、经、管等多学科协调发展的国家“211工程”重点建高校和“世界一流学科”建设高校，是黑龙江省人民政府与农业农村部省部共建大学、国家“中西部高校基础能力建设工程”支持高校、教育部本科教学工作水平评估优秀院校。学校于1948年创建于哈尔滨，始称东北农学院，是中国共产党在解放区创办的第一所普通高等农业院校，知名教育家、哈尔滨市第一任市长刘达为学校第一任院长。建校以来，先后隶属于东北行政委员会农业部、高等教育部、农业部、黑龙江省农业委员会、黑龙江省教育厅，1981年被确定为黑龙江省省属重点院校，1994年与黑龙江省农业管理干部学院合并组建东北农业大学。\"},{\"id\":179,\"name\":\"华南农业大学\",\"en_name\":\"South China Agricultural University\",\"tags\":\"高等院校综合类双一流\",\"ranks\":\"\",\"rank\":120,\"province_id\":18,\"info\":\"华南农业大学是国家“双一流”建设高校。校园坐落在素有“花城”美誉的广州市，土地总面积8261亩，其中天河五山校部4457亩，增城教学科研基地3804亩。学校建筑总面积140万平方米。自然景色与人文景观交相辉映，形成了“五湖四海一片林”的优美环境。\"},{\"id\":256,\"name\":\"杭州电子科技大学\",\"en_name\":\"Hangzhou Dianzi University\",\"tags\":\"211,985,双一流\",\"ranks\":\"91,140\",\"rank\":125,\"province_id\":5,\"info\":\"杭州电子科技大学是多学科相互渗透的高等学府，是浙江省首批重点建设高校，是国家国防科工局和浙江省人民政府共建高校。学校拥有从学士、硕士到博士的完整人才培养体系，入选全国百强高校、全国新生质量百强高校、全国高校毕业生就业竞争力百强高校。建校六十余年来，学校已成为浙江省乃至我国信息技术领域人才平台培养的重要基地，一大批校友成为我国著名IT企业的领军人物，被誉为“IT企业家的摇篮”、“卓越会计师的沃土”。\"},{\"id\":110,\"name\":\"新疆大学\",\"en_name\":\"Xinjiang University\",\"tags\":\"211,双一流\",\"ranks\":\"136,138\",\"rank\":125,\"province_id\":26,\"info\":\"新疆大学的前身——新疆俄文法政专门学校于1924年创立，1935年改建为新疆学院。1950年，新疆省人民政府将原省语文学院并入新疆学院，并将新疆学院更名为新疆民族学院；1954年复名为新疆学院。1959年5月，高等教育部决定由北京大学、清华大学、西北大学等院校支援新疆大学的成立工作。1960年新疆大学正式成立。2000年，新疆大学与原新疆工学院合并组建为新的新疆大学。1997年，学校被列入国家首批“211工程”重点建设高校。2004年，学校成为新疆维吾尔自治区人民政府、教育部共建高校。2017年进入全国首批42所世界一流大学建设高校行列。2018年被确定为教育部与新疆维吾尔自治区人民政府部区合建高校。学校现有校本部、南校区、北校区三个校区，共占地290.9万平方米。\"},{\"id\":172,\"name\":\"河南大学\",\"en_name\":\"Henan University\",\"tags\":\"双一流\",\"ranks\":\"98,83\",\"rank\":129,\"province_id\":15,\"info\":\"河南大学创办于1912年，始名河南留学欧美预备学校，2008年河南大学成为省部共建高校，2016年入选国家“111计划”，2017年成为首批“双一流”建设高校。 河南大学主要有开封明伦校区、金明校区和郑州龙子湖校区三个校区。拥有12个学科门类，开设有98个本科专业，43个硕士学位授权一级学科，24种硕士专业学位授权类别，20个博士学位授权一级学科，19个博士后科研流动站。\"},{\"id\":182,\"name\":\"广州大学\",\"en_name\":\"Guangzhou University\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":130,\"province_id\":18,\"info\":\"大学与城市共生共荣共成长。广州大学是以国家重要中心城市“广州”命名的综合性大学，于2000年合并组建，有着90多年的办学传统。学校紧紧抓住国家“双一流”建设、广东省和广州市高水平大学建设机遇，坚持“四个面向”，深化与广州和粤港澳大湾区“三个对接”，聚焦新工科、新文科、新师范建设，积极探索新医科和新农科发展，是广东省高水平大学建设计划重点建设高校、广州市高水平大学建设高校。\"},{\"id\":183,\"name\":\"广东工业大学\",\"en_name\":\"Guangdong University of Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":131,\"province_id\":18,\"info\":\"广东工业大学是一所以工为主、工理经管文法艺结合、多科性协调发展的省属重点大学、广东省高水平大学重点建设高校，1958年开办本科教育，1995年由原广东工学院、广东机械学院和华南建设学院（东院）合并组建而成。2022年软科世界大学学术排名401—500名，泰晤士高等教育世界排名位列中国大陆高校第49—65名。\"},{\"id\":335,\"name\":\"成都理工大学\",\"en_name\":\"Chengdu University of Technology\",\"tags\":\"高等院校理工类双一流\",\"ranks\":\"\",\"rank\":132,\"province_id\":19,\"info\":\"成都理工大学是教育部与四川省共建的省属重点大学，是国家首批“双一流”建设高校。学校有成都和宜宾两个校区，占地面积3887亩，校舍建筑面积144.7万平方米，校园绿树成荫、繁花似锦，是读书治学的美好园地。\\n\\n成都理工大学的前身是创办于1956年的成都地质勘探学院，是共和国建国初期创办的三所地质院校之一。此后历经成都地质学院、成都理工学院的历史时期，2001年合并四川商业高等专科学校和有色金属地质职工大学，组建成都理工大学。\"},{\"id\":224,\"name\":\"山西大学\",\"en_name\":\"Shanxi University\",\"tags\":\"双一流\",\"ranks\":\"103,89\",\"rank\":132,\"province_id\":7,\"info\":\"山西大学坐落在具有2500多年历史的文化古都——山西省太原市。学校前身为创建于1902年的山西大学堂，其悠远的文脉可以上溯至明代三立书院及清代晋阳书院和令德书院。早期的山西大学堂中西合璧、文理并重，办学思路开阔，育人理念先进，是我国近代高等教育重要的发祥地之一，也是三晋大地百年文化科教的重镇。百年育英才，盛世续华章。近年来，承载着科教兴国、人才强国的时代使命，山西大学实现了跨越式发展，成为一所文理工并重的高水平综合性大学。1998年成为山西省重点建设大学；2005年成为山西省人民政府与教育部共同建设的省部共建大学；2012年成为全国14所“中西部高校提升综合实力工程”入选高校之一，迈上了国家建设“有特色、高水平”大学的新平台。2014年，太原电力高等专科学校并入，学校的学科结构进一步完善。2016年，学校成为国家中西部“一省一校”重点建设大学。2017年，山西省出台意见支持山西大学深入实施“1331工程”，对标“双一流”实现率先发展。2018年，在省部共建和“一省一校”建设基础上，学校正式成为教育部和山西省政府合建高校。\"},{\"id\":310,\"name\":\"湘潭大学\",\"en_name\":\"Xiangtan University\",\"tags\":\"等院校综合类双一流\",\"ranks\":\"\",\"rank\":133,\"province_id\":17,\"info\":\"湘潭大学简称“湘大”，是一代伟人毛泽东同志亲自倡办的综合性全国重点大学、国家“双一流”建设高校。学校创办于1958年，同年9月10日，毛泽东同志亲笔题写“湘潭大学”校名，并亲切嘱托“一定要把湘潭大学办好”。1974年，邓小平、李先念等中央领导同志批准湘潭大学复校。1978年，学校被国务院确定为全国16所文理工综合性重点大学之一。1981年，学校成为全国首批硕士学位授权单位。复校以来，华国锋、江泽民、李鹏等党和国家领导人先后对学校的建设发展给予了高度重视与亲切关怀。\"},{\"id\":243,\"name\":\"南京信息工程大学\",\"en_name\":\"Nanjing University of Information Science & Technology\",\"tags\":\"双一流\",\"ranks\":\"90,116\",\"rank\":134,\"province_id\":4,\"info\":\"南京信息工程大学是国家“双一流”建设高校，是江苏高水平大学建设高校。学校始建于1960年，应新中国国家战略和国民经济建设需求而生，隶属中央(军委)气象局，前身为南京大学气象学院，1963年独立建校为南京气象学院，1978年列入全国重点大学，2004年更名为南京信息工程大学。2007年以来，先后实现了江苏省人民政府、中国气象局、教育部、国家海洋局的多方共建。现为以江苏省管理为主的中央与地方共建高校。\"},{\"id\":284,\"name\":\"山东师范大学\",\"en_name\":\"Shandong Normal University\",\"tags\":\"高等院校师范类A区\",\"ranks\":\"\",\"rank\":135,\"province_id\":14,\"info\":\"山东师范大学坐落在历史文化名城济南。建校70年来，学校植根齐鲁文化沃土，汲取泉城人文灵韵，秉承“尊贤尚功、奋发有为”的校园精神和“弘德明志、博学笃行”的校训，自觉传承创新齐鲁文化，努力彰显教师教育特色，目前已发展成为一所学科专业齐全、学位体系完备、师资人才充沛、社会声誉优良的综合性高等师范院校。\"},{\"id\":250,\"name\":\"浙江理工大学\",\"en_name\":\"Zhejiang Sci-Tech University\",\"tags\":\"211,985,双一流\",\"ranks\":\"114,115\",\"rank\":136,\"province_id\":5,\"info\":\"浙江理工大学是一所特色鲜明，优势突出，理学、工学、文学、艺术学、经济学、管理学、法学、教育学等多学科协调发展的浙江省重点建设高校，是教育部本科教学工作水平评估优秀高校。学校拥有从学士、硕士到博士的完整人才培养体系，具有推荐优秀应届本科毕业生免试攻读硕士学位研究生资格。\"},{\"id\":230,\"name\":\"上海理工大学\",\"en_name\":\"University of Shanghai for Science and Technology\",\"tags\":\"211,985,双一流\",\"ranks\":\"102,74\",\"rank\":137,\"province_id\":3,\"info\":\"上海理工大学源于1906年创办的沪江大学和1907年创办的德文医工学堂。20世纪50年代初，沪江大学和国立上海高级机械职业学校分别改建为上海机械学院（1994年更名为华东工业大学）和上海机械高等专科学校，1996年两校合并组建上海理工大学；1998年学校由机械工业部转入上海市管理。上海理工大学是一所以工学为主，工学、理学、经济学、管理学、文学、法学、艺术学等多学科协调发展的应用研究型大学，是国家国防科技工业局与上海市人民政府共建高校。\"},{\"id\":286,\"name\":\"青岛大学\",\"en_name\":\"Qingdao University\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":138,\"province_id\":14,\"info\":\"青岛大学是山东省重点建设高校、山东省和青岛市共建高校、山东省高水平大学和高水平学科建设高校。\\n\\n学校办学历史可追溯至1909年创办的青岛特别高等专门学堂。1993年由原青岛大学、山东纺织工学院、青岛医学院、青岛师范专科学校等合并组建而成。\\n\\n百十余年来，学校教授高深学问，养成硕学闳才，应国家之需要，薪火相传，砥砺奋进，从这里走出了40余万优秀校友，为区域经济社会发展和人类文明进步做出了重要贡献。\"},{\"id\":164,\"name\":\"燕山大学\",\"en_name\":\"Yanshan University\",\"tags\":\"211,985,双一流\",\"ranks\":\"94,63\",\"rank\":139,\"province_id\":6,\"info\":\"燕山大学源于哈尔滨工业大学，始建于1920年；1960年独立办学，定名为东北重型机械学院；1985-1997年学校整体南迁至秦皇岛市；1997年更名为燕山大学；2000年，河北轻工业管理学校并入。燕山大学是河北省人民政府、教育部、工业和信息化部、国家国防科技工业局共建的全国重点大学。\"},{\"id\":347,\"name\":\"西安建筑科技大学\",\"en_name\":\"Xi'an University of Architecture and Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":140,\"province_id\":20,\"info\":\"西安建筑科技大学坐落于历史文化名城西安，现有雁塔、草堂两个校区和一个科教产业园区。雁塔校区南眺驰名中外的唐代大雁塔，北临举世闻名的明代古城墙；草堂校区坐落于高新区草寺东路；华清科教产业园位于西安高新技术东开发区幸福林带南段，东依景色怡人的浐灞生态园；两校区和产业园区总占地3700余亩。\"},{\"id\":324,\"name\":\"昆明理工大学\",\"en_name\":\"Kunming University of Science and Technology\",\"tags\":\"高等院校综合类B区\",\"ranks\":\"\",\"rank\":141,\"province_id\":23,\"info\":\"昆明理工大学创建于1954年9月1日，时名“昆明工学院”，1995年更名为“昆明理工大学”，1999年原昆明理工大学与原云南工业大学合并组建新的昆明理工大学。学校现有呈贡、莲华、新迎、嵩明四个校区，占地3915亩（不含嵩明校区），主校区为呈贡校区，位于昆明市呈贡大学城。\"},{\"id\":116,\"name\":\"内蒙古大学\",\"en_name\":\"Inner Mongolia University\",\"tags\":\"综合类211双一流\",\"ranks\":\"\",\"rank\":142,\"province_id\":31,\"info\":\"内蒙古大学位于内蒙古自治区首府、历史文化名城呼和浩特市，距北京400余公里，是中华人民共和国成立后党和国家在少数民族地区创办的第一所综合大学。学校于1957年高起点创办，时任国务院副总理、自治区主席乌兰夫任首任校长（1956—1968），原高教部综合大学司副司长于北辰任副校长，中科院学部委员、著名生物学家、北京大学一级教授、耶鲁大学博士李继侗先生来校执教并任学术副校长。党和政府从北京大学等国内十几所著名高校，选派一批知名学科带头人和学术骨干组成了建校初期高水平的师资队伍，带来名校积淀悠久的治学传统和崇高大学精神，为学校后续发展奠定了坚实办学基础和优良学风校风。\"},{\"id\":298,\"name\":\"江西师范大学\",\"en_name\":\"Jiangxi Normal University\",\"tags\":\"高等院校师范类A区\",\"ranks\":\"\",\"rank\":143,\"province_id\":13,\"info\":\"江西师范大学是教育部、江西省人民政府共建高校和中西部高校基础能力建设工程高校。学校融哲学、经济学、法学、教育学、文学、历史学、理学、工学、管理学、艺术学等十大学科门类于一体，位于具有深厚历史文化底蕴，素有“物华天宝、人杰地灵”美誉的江西省省会南昌，对江西的政治、经济、文化和社会发展有较大影响，被江西省人民政府确定为优先发展的省属重点（师范）大学。学校现有瑶湖、青山湖两个校区，占地面积3500余亩，建筑面积140余万平方米。\"},{\"id\":346,\"name\":\"西安理工大学\",\"en_name\":\"Xi'an University of Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":144,\"province_id\":20,\"info\":\"西安理工大学是国家“中西部高等教育振兴计划”入选高校，工信部  与陕西省共建高校，陕西省重点建设的高水平大学，陕西省“国内一流大学建设高校”。学校是我国水利水电、装备制造、印刷包装行业高级专门人才的重要培养基地和科研中心之一。\"},{\"id\":234,\"name\":\"上海师范大学\",\"en_name\":\"Shanghai Normal University\",\"tags\":\"211,985,双一流\",\"ranks\":\"111,133\",\"rank\":145,\"province_id\":3,\"info\":\"上海师范大学创建于1954年，时名上海师范专科学校；1956年扩建为本科院校上海第一师范学院和上海第二师范学院；1958年两校合并成立上海师范学院；1972年五校合并成立上海师范大学；1978年恢复上海师范学院；1984年改名为上海师范大学；1994年与上海技术师范学院合并成立新的上海师范大学。上海师范大学是上海市重点建设高校、上海市高水平地方高校（学科）建设试点单位。\"},{\"id\":257,\"name\":\"杭州师范大学\",\"en_name\":\"Hangzhou Normal University\",\"tags\":\"211,985,双一流\",\"ranks\":\"129,147\",\"rank\":146,\"province_id\":5,\"info\":\"杭州师范大学前身为1908年的浙江官立两级师范学堂，2017年列为省重点建设高校。学校坚持“勤慎诚恕，博雅精进”校训，弘扬“包容开放、学与俱进、追求卓越”师大精神，培养了丰子恺、潘天寿等杰出校友，涌现了中国科学院院士蔡荣根、数字经济创新者马云等优秀人才。 学校坚持立足杭州、服务浙江，辐射全国、面向世界的办学定位，保持师范教育特色，提高学校核心竞争力，建设成为实力强劲、特色鲜明、文化厚重的一流大学！\"},{\"id\":301,\"name\":\"武汉科技大学\",\"en_name\":\"Wuhan University of Science and Technology\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":146,\"province_id\":16,\"info\":\"武汉科技大学是湖北省人民政府和教育部共建的地方高水平大学，是国家国防科技工业局与湖北省人民政府共建高校，是湖北省“双一流”建设重点高校，是“全国深化创新创业教育改革示范高校”、首批“国家知识产权试点高校”、首批“高等学校科技成果转化和技术转移基地”、“创新人才培养示范基地”、首批“省级双创示范基地”和“省级大学生创业示范基地”。\"},{\"id\":278,\"name\":\"山东科技大学\",\"en_name\":\"Shandong University of Science and Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":147,\"province_id\":14,\"info\":\"学校建校于1951年，是一所工科优势突出，行业特色鲜明，工学、理学、管理学、文学、法学、经济学、艺术学等多学科相互渗透、协调发展的山东省重点建设应用基础型人才培养特色名校和高水平大学“冲一流”建设高校。\\n\\n在青岛、泰安、济南三地办学，总占地面积3500余亩，建筑面积145万平方米，固定资产总值40亿元，教学科研仪器设备总值9.71亿元。学校设有教学单位34个，科研单位5个。有博士后科研流动站9个，博士学位授权一级学科10个，硕士学位授权一级学科31个，硕士专业学位类别19个，本科专业97个。有国家重点（培育）学科1个，山东省高水平学科4个，山东省一流学科5个，另有省市级重点学科19个，工程学、数学、化学、材料科学、地球科学、计算机科学、环境与生态学7个学科进入ESI全球排名前1%。\"},{\"id\":350,\"name\":\"陕西科技大学\",\"en_name\":\"Shaanxi University of Science and Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":148,\"province_id\":20,\"info\":\" \\n陕西科技大学是国家“中西部高校基础能力建设工程”及“十四五教育强国推进工程”建设高校，是陕西省国家“双一流”培育高校和重点建设的高水平大学。\\n\\n学校创建于1958年，时名北京轻工业学院，是新中国第一所轻工高等学校；1970年迁至陕西咸阳，改名西北轻工业学院；1978年被国务院确定为全国88所重点院校之一；1998年学校划转陕西省，实行中央与地方共建；2002年经教育部批准，更名陕西科技大学；2006年学校主体迁西安市。\"},{\"id\":268,\"name\":\"福建农林大学\",\"en_name\":\"Fujian Agriculture and Forestry University\",\"tags\":\"高等院校农林类A区\",\"ranks\":\"\",\"rank\":149,\"province_id\":12,\"info\":\"福建农林大学地处海上丝绸之路门户、首批对外开放的沿海港口城市——福州，是一所以农林学科为优势和特色，理、工、经、管、文、法、艺等多学科协调发展的省属重点大学，是农业农村部、国家林草局与福建省政府共建高校，福建省一流大学建设高校。\\n\\n福建农林大学的前身是成立于1936年的福建协和大学农科和成立于1940年的福建省立农学院。1952年，两大文脉汇集成立福建农学院。1958年秋，省委省政府以福建农学院森林系为基础，成立福建林学院。2000年10月，原福建农业大学和原福建林学院合并组建新的福建农林大学。\"},{\"id\":311,\"name\":\"长沙理工大学\",\"en_name\":\"Changsha University of Science and Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":150,\"province_id\":17,\"info\":\"长沙理工大学是一所以工为主，工、理、管、经、文、法、哲、艺等多学科协调发展，以本科、研究生教育为主体，具有博士后科研流动站、博士学位授予权和硕士生推免权的多科性大学。学校是全国先进基层党组织、国家“中西部高校基础能力建设工程”高校、首批全国“创新创业典型经验高校”50强、湖南省“国内一流大学建设高校”（A类）、湖南省文明标兵单位、湖南省依法治校示范学校。\"},{\"id\":158,\"name\":\"河北大学\",\"en_name\":\"Hebei University\",\"tags\":\"\",\"ranks\":\"130,90\",\"rank\":151,\"province_id\":6,\"info\":\"河北大学是教育部与河北省人民政府“部省合建”高校，也是河北省重点支持的国家一流大学建设一层次高校。学校始建于1921年，初名天津工商大学；1933年改名天津工商学院；1948年更名为津沽大学；1951年，中央人民政府接收津沽大学并改之为国立，由天津市政府领导。1952年，中央人民政府对全国高校布局及院系进行调整，津沽大学的工学院、财经学院分别并入天津大学、南开大学，另以师范学院为基础，在原址建成天津师范学院。1958年，天津师范学院扩建为天津师范大学，其后被确定为全省5所重点大学之一。1960年，天津师范大学改建为综合性大学并定名河北大学。1970年，河北大学由天津迁至国家历史文化名城——河北省保定市。2000年河北省技术监督学校并入，2005年河北省职工医学院及其附属医院并入。学校占地面积2430亩，建筑面积136万平方米，有五四路校区、七一路校区和裕华路校区等校区。\"},{\"id\":112,\"name\":\"宁夏大学\",\"en_name\":\"Ningxia University\",\"tags\":\"211,985,双一流\",\"ranks\":\"149,182\",\"rank\":152,\"province_id\":27,\"info\":\"宁夏大学是教育部与宁夏回族自治区人民政府合建高校，国家“双一流”建设高校，国家“211工程”重点建设高校。\\n\\n宁夏大学始建于1958年。1997年12月，宁夏大学与原宁夏工学院、银川师专（含宁夏教育学院）合并；2002年2月，与宁夏农学院合并，组建了新的宁夏大学；2014年4月，宁夏大学中卫校区成立，揭开了学校改革发展崭新一页。\\n\\n学校坐落在历史悠久、风光秀丽的塞上历史文化名城银川市，占地面积2938亩，教学实验农场1890亩，校舍建筑面积88万平方米。在校教职工2719人。面向28个省、自治区、直辖市招生，现有全日制普通本科生19116人，全日制硕士研究生5020人、全日制博士研究生541人，少数民族预科生985人，国际留学生157人。校园楼宇林立、花木繁茂、环境幽雅，是读书治学的理想园地。\"},{\"id\":336,\"name\":\"西南石油大学\",\"en_name\":\"Southwest Petroleum University\",\"tags\":\"高等院校综合类双一流\",\"ranks\":\"\",\"rank\":153,\"province_id\":19,\"info\":\"西南石油大学是新中国创建的第二所石油本科院校，是一所中央与地方共建、以四川省人民政府管理为主的高等学校。2013年，学校入选\\\"国家中西部高校基础能力建设工程\\\"，成为入选该工程的100所高校之一。2017年9月，入选为国家首批“双一流”世界一流学科建设高校。\"},{\"id\":56,\"name\":\"辽宁大学\",\"en_name\":\"Liaoning University\",\"tags\":\"211,双一流\",\"ranks\":\"127,93\",\"rank\":154,\"province_id\":8,\"info\":\"辽宁大学源起于1948年11月东北人民政府在沈阳建立的商业专门学校，是中国共产党创建的第一所专门商科高校。1953年，东北商业专科学校合入东北财经学院。1958年，东北财经学院、沈阳师范学院的部分科系与沈阳俄文专科学校合并，组建成辽宁大学。辽宁大学是国家世界一流学科建设高校、“211工程”重点建设高校、辽宁省一流大学重点建设高校，入选“卓越法律人才教育培养计划”“国家建设高水平大学公派研究生项目”“国家级大学生创新创业训练计划”，为全国深化创新创业教育改革示范高校、国家大学生文化素质教育基地、中国自由贸易试验区研究院联盟成员单位。\"},{\"id\":304,\"name\":\"湖北大学\",\"en_name\":\"Hubei University\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":155,\"province_id\":16,\"info\":\"湖北大学地处国家中部地区中心城市、湖北省省会——武汉市内，学校前身是1931年在武昌成立的湖北省立教育学院，1984年8月更名改制为湖北大学。学校是湖北省人民政府与教育部共建的省属重点综合性大学，也是国家“中西部高校基础能力建设工程”高校、湖北省“国内一流大学建设高校”。\"},{\"id\":209,\"name\":\"长春理工大学\",\"en_name\":\"Changchun University of Science and Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":156,\"province_id\":9,\"info\":\"长春理工大学原名长春光学精密机械学院，1958年由中国科学院创办，是新中国第一所培养光学专门人才的高等院校。经过60多年的建设与发展，学校现已成为一所具有鲜明光电特色和国防特色的吉林省省属重点大学，是吉林省、国家国防科技工业局、长春市共建院校，享有“中国光学英才摇篮”的美誉。\"},{\"id\":111,\"name\":\"石河子大学\",\"en_name\":\"Shihezi University\",\"tags\":\"211,双一流\",\"ranks\":\"138,186\",\"rank\":157,\"province_id\":26,\"info\":\"石河子大学的前身诞生于1949年9月中国人民解放军解放新疆的进军途中，1996年4月由石河子农学院、石河子医学院、兵团师范专科学校和兵团经济专科学校合并组建。石河子大学是国家“211工程”重点建设高校、国家西部大开发重点建设高校和省部共建高校，是国家“中西部高校基础能力建设工程”和“中西部高校综合实力提升工程”（一省一校）入选高校。学校于2017年入选国家“双一流”建设（一流学科）高校，全国首批深化创新创业教育改革示范高校、第三批“全国高校实践育人创新创业基地”，2018年入选教育部与新疆生产建设兵团“部省合建”高校，2019年入选第二批“全国党建工作示范高校”培育创建单位，2020年获评“全国文明校园”。学校始终坚持“立足兵团、服务新疆、面向全国、辐射中亚”的办学定位，坚持“以服务为宗旨，在贡献中发展”的办学理念，坚持“以兵团精神育人，为维稳戍边服务”的办学特色，成为维稳戍边、建设边疆的重要力量。\"},{\"id\":148,\"name\":\"天津工业大学\",\"en_name\":\"Tiangong University\",\"tags\":\"双一流\",\"ranks\":\"\",\"rank\":158,\"province_id\":2,\"info\":\"天津工业大学是教育部与天津市共建、天津市重点建设的全日制普通高等学校。学校办学历史悠久，始建于1912年，2000年更名为天津工业大学，2017年入选国家“双一流”世界一流学科建设高校，2018年获批国防科工局与天津市共建高校，是我国最早开展纺织高等教育的学府之一，现已发展成为一所以工为主，工、理、文、管、经、法、艺、医协调发展的多科性综合大学。\"},{\"id\":264,\"name\":\"安徽师范大学\",\"en_name\":\"Anhui Normal University\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":159,\"province_id\":11,\"info\":\"安徽师范大学是安徽建校最早的高等学府，坐落在具有“徽风皖韵、千湖之城”美誉的国家级开放城市——芜湖，濒临浩瀚长江，傍依灵秀赭山，集江南自然之神秀、汇安徽人文之灵杰，是安徽省人民政府与教育部共建高校、安徽省委省政府优先建设的省属重点综合性大学和安徽省特色高水平大学重点建设高校，入选全国重点马克思主义学院（安徽省唯一）、全国首批省委宣传部与学校共建新闻学院试点单位，荣获第二届“全国文明校园”称号。\"},{\"id\":238,\"name\":\"江苏科技大学\",\"en_name\":\"Jiangsu University of Science and Technology\",\"tags\":\"普通高端院校\",\"ranks\":\"137,215\",\"rank\":160,\"province_id\":4,\"info\":\"江苏科技大学坐落在风景秀丽的国家历史文化名城——江苏省镇江市，是一所以工科为主，特色鲜明的普通高等学校，是江苏省重点建设高校，教育部本科教学工作水平评估优秀学校，教育部卓越工程师教育培养计划高校。学校现有博士后科研流动站3个，一级学科博士学位授权点4个，一级学科硕士学位授权点20个，硕士专业学位培养类别10个，本科专业66个。目前，工程学、材料科学、化学3个学科进入ESI学科全球排名前1%。\"},{\"id\":150,\"name\":\"天津师范大学\",\"en_name\":\"Tianjin Normal University\",\"tags\":\"211,985,双一流\",\"ranks\":\"148,111\",\"rank\":161,\"province_id\":2,\"info\":\"天津师范大学为天津市属重点院校，始建于1958年，原名天津师范学院，1982年更名为天津师范大学。1999年，原天津师范大学、天津师范高等专科学校、天津教育学院合并组建新的天津师范大学。学校践行“勤奋严谨、自树树人”之校训，培育“学思并重、知行合一”之学风，崇尚“诚实守信、勇于担当”之校风。坚持立德树人根本任务，坚守师范初心，深耕完善师范办学体系，把为基础教育输送优质师资作为坚定追求，将师范教育摆在中心地位，以办好高质量师范教育为“固本之策”，培根铸魂、强基固本、涵养师德。学校占地面积3500亩，内含771亩自然湖泊湿地，建筑面积86万平方米，教学设施条件齐备，人文精神积淀厚重；美丽校园环境优雅，生态风格气质独特。\"},{\"id\":246,\"name\":\"江苏师范大学\",\"en_name\":\"Jiangsu Normal University\",\"tags\":\"师范院校\",\"ranks\":\"125,140\",\"rank\":162,\"province_id\":4,\"info\":\"江苏师范大学的前身是1952年创办的苏南军区转业干部文化速成学校。1956年成立江苏省中学师资训练班。1957年成立江苏师范专科学校。1959年与徐州师范专科学校合并，成立徐州师范学院，是当时苏北地区唯一的本科高校。1981年成为全国首批硕士学位授予单位。1996年更名为徐州师范大学。1999年原煤炭部所属的徐州工业学校并入。2011年更为现名。江苏师范大学是江苏省和徐州市重点建设的省属重点大学，教育部与江苏省人民政府共建高校，江苏高水平大学建设高校。2017年，学校成为江苏省博士学位授权立项建设单位。\"},{\"id\":282,\"name\":\"山东农业大学\",\"en_name\":\"Shandong Agricultural University\",\"tags\":\"高等院校农林类A区\",\"ranks\":\"\",\"rank\":163,\"province_id\":14,\"info\":\"山东农业大学坐落在雄伟壮丽的泰山脚下，前身是1906年创办于济南的山东高等农业学堂。后几经变迁，1952年经全国院系调整，成立山东农学院。1958年由济南迁至泰安，1983年更名为山东农业大学。1999年7月，原山东农业大学、山东水利专科学校合并，同时山东省林业学校并入，组建新的山东农业大学。目前，学校已经发展成为一所以农业科学为优势，生命科学为特色，融农、理、工、管、经、文、法、艺术学等于一体的多科性大学。\"},{\"id\":232,\"name\":\"上海海洋大学\",\"en_name\":\"Shanghai Ocean University\",\"tags\":\"双一流\",\"ranks\":\"167,212\",\"rank\":164,\"province_id\":3,\"info\":\"上海海洋大学是多科性应用研究型大学，上海市人民政府与国家海洋局、农业农村部共建高校。前身是张謇、黄炎培创建于1912年的江苏省立水产学校。1952年升格为中国第一所本科水产高校——上海水产学院。1972年南迁厦门集美，1979年迁回上海。1985年更名为上海水产大学，2008年更名为上海海洋大学。2017年9月，学校入选国家世界一流学科建设高校。学校现有上海市浦东新区沪城环路校区、杨浦区军工路校区2个校区，其中主校区沪城环路校区占地约1600余亩，另有滨海基地386亩、象山科教基地56.7亩。建有中国远洋渔业数据中心和海洋科学超级计算中心。\"},{\"id\":308,\"name\":\"湖北工业大学\",\"en_name\":\"Hubei University of Technology\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":165,\"province_id\":16,\"info\":\"湖北工业大学创建于1952年，是一所以工学为主，经济学、法学、教育学、文学、理学、医学、管理学、艺术学、交叉学科等十大学科门类协调发展的多科性大学，是湖北省“双一流”建设高校、国家“中西部高校基础能力建设工程”高校、全国毕业生就业典型经验高校、全国深化创新创业教育改革示范高校、国家知识产权试点高校、国家“赋予科研人员职务科技成果所有权或长期使用权试点单位”、首批国家级现代产业学院建设单位、全国文明校园先进学校。\"},{\"id\":171,\"name\":\"河南农业大学\\t\",\"en_name\":\"Henan Agricultural University\",\"tags\":\"高等院校农林类A区\",\"ranks\":\"\",\"rank\":166,\"province_id\":15,\"info\":\"筚路蓝缕，栉风沐雨，河南农业大学走过120余年的办学历程，见证了河南近现代高等教育的历史，见证了河南近现代农业教育的历史。学校源自1902年创办的河南大学堂，1912年改办为河南公立农业专门学校，1927年与中州大学、河南公立法政专门学校合并为国立第五中山大学，1952年全国院系调整时重新独立建制更名为河南农学院，1984年更名为河南农业大学。2009年成为农业农村部与地方省政府共建的第一所省属农业高校。2012年成为国家林业和草原局与省政府共建高校。2013年学校牵头的河南粮食作物协同创新中心入选国家首批“2011计划”。\"},{\"id\":194,\"name\":\"沈阳农业大学\",\"en_name\":\"Shenyang Agricultural University\",\"tags\":\"高等院校 农林类 A区\",\"ranks\":\"\",\"rank\":168,\"province_id\":8,\"info\":\"沈阳农业大学坐落在国家历史文化名城沈阳市，东与世界文化遗产清福陵毗邻，南与沈水浑河相望，北倚天柱山，占地面积10246亩。校园环境幽雅，风景秀丽，人文气息浓厚，教学、科研条件优越。\\n\\n沈阳农业大学的办学历史可以追溯到1906年的省立奉天农业学堂。1952年全国高等院校调整，以复旦大学农学院与东北农学院部分系科为基础，成立了新的沈阳农学院。1979年经国务院批准为全国重点高等院校。1981年成为首批具有博士、硕士学位授予权单位。1985年更名为沈阳农业大学，邓小平同志为学校题写了校名。2000年，由农业部所属划转为以辽宁管理为主，中央与地方共建的全国重点大学。\"},{\"id\":173,\"name\":\"河南师范大学\",\"en_name\":\"Henan Normal University\",\"tags\":\"高等院校师范类A区\",\"ranks\":\"\",\"rank\":169,\"province_id\":15,\"info\":\"河南师范大学位于豫北名城新乡市，北依巍巍太行，南濒滔滔黄河，坐落在广袤的牧野大地、美丽的卫水之滨。学校是国家中西部高等教育振兴计划支持高校、国家“111计划”实施高校、河南省人民政府与教育部共建高校、教育部本科教学工作水平评估优秀学校和河南省特色骨干大学，河南省“双一流”创建高校，三度蝉联全国文明单位，入选第二届全国文明校园。\"},{\"id\":343,\"name\":\"重庆邮电大学\",\"en_name\":\"Chongqing University of Posts and Telecommunications\",\"tags\":\"高等院校理工类A区\",\"ranks\":\"\",\"rank\":170,\"province_id\":21,\"info\":\"重庆邮电大学是国家布点设立并重点建设的邮电高校之一，是工业和信息化部与重庆市共建的一所特色鲜明、优势突出，在信息通信领域具有重要影响的高水平教学研究型大学。学校发轫于1950年，在抗战时期交通部邮政总局原址上开办邮政人员培训班；在此基础上，先后举办西南邮电分校、重庆邮电学校和重庆电信学校；1959 年由国务院批准成立为重庆邮电学院，并开始本科教育；1965年成为当时四川省招收研究生的10所院校之一；于1970年改建为电信总局529厂，1973年改建为邮电部第九研究所，1979年恢复办学。2000年由原信产部划转重庆市管理，实行部市共建；2006 年更名为重庆邮电大学；2013年批准为博士学位授予单位。\"},{\"id\":337,\"name\":\"四川师范大学\",\"en_name\":\"Sichuan Normal University\",\"tags\":\"高等院校师范类A区\",\"ranks\":\"\",\"rank\":201,\"province_id\":19,\"info\":\"四川师范大学是四川省属重点大学、国家首批“中西部高校基础能力建设工程”实施高校及全国深化创新创业教育改革示范校，是四川省举办本科师范教育最早、师范类院校中办学历史最为悠久的大学。学校位于四川省省会——成都市，现有狮子山校区、成龙校区两个校区。\"},{\"id\":122,\"name\":\"西南科技大学\",\"en_name\":\"Southwest University of Science and Technology\",\"tags\":\"理工类,省部共建,西部重点建设十四所之一\",\"ranks\":\"130,206,/,1066,201,145\",\"rank\":208,\"province_id\":19,\"info\":\"设有国防科技学院等16个学院（部），工学、农学、理学、经济学、法学、文学、管理学、教育学、艺术学等9大学科门类。设有本科专业81个，招生专业79个，一级学科硕士点22个，一级学科博士点4个，博士后科研流动站1个，4个学科方向与中国工程物理研究院等开展联合培养博士研究生。国家级一流本科专业建设点13个，省级一流本科专业建设点15个。学校化学学科、工程学科、材料科学学科3个学科进入ESI全球排名前1%\"},{\"id\":419,\"name\":\"成都信息工程大学\",\"en_name\":\"Chengdu University of Information Technology\",\"tags\":\"理工类\",\"ranks\":\"255\",\"rank\":255,\"province_id\":19,\"info\":\"成都信息工程大学是四川省和中国气象局共建、四川省重点发展的省属普通本科院校。学校创建于1951年，1956年改制为中央气象局成都气象学校；1978年升格为本科院校——成都气象学院；2000年由中国气象局划转四川省，更名为成都信息工程学院；2001年，原隶属国家统计局的四川统计学校整体并入；2015年更名为成都信息工程大学。学校是国家“中西部基础能力建设工程”建设高校、首批教育部“卓越工程师教育培养 ”实施院校、四川省首批一流学科建设高校、四川省新增博士学位授予单位建设高校。学校现有航空港、龙泉两个校区，占地面积2000余亩。学校拥有馆藏丰富的图书馆和设施齐备的现代化体育场馆，环境幽雅，景色宜人，是读书治学的理想场所。\"},{\"id\":339,\"name\":\"西华师范大学\",\"en_name\":\"China West Normal University\",\"tags\":\"高等院校师范类A区\",\"ranks\":\"\",\"rank\":258,\"province_id\":19,\"info\":\"西华师范大学是四川省属重点大学。学校创建于1946年，发轫于抗日战争时期的国立东北大学。抗战初期，东北大学内迁至四川省三台县办学。抗战胜利后，东北大学迁回沈阳，在川北有识之士倡议及川北三十六县十盐场支持下，依托东北大学的川籍师生在三台原校址创建了私立川北农工学院。1949年私立川北农工学院与著名墨学专家伍非百先生创立的西山书院共同组建私立川北大学。1950年学校迁至南充市，与川北文学院合并组建公立川北大学。\"},{\"id\":340,\"name\":\"西华大学\",\"en_name\":\"Xihua University\",\"tags\":\"高等院校综合类A区\",\"ranks\":\"\",\"rank\":270,\"province_id\":19,\"info\":\"西华大学是四川省属重点综合性大学。学校拥有郫都、宜宾、彭州、人南、易三仓（泰国）五个校区，校园面积近4000亩，地理位置优越，环境优雅宜人，设施设备齐全先进，图书文献资源丰富，荣获四川省五一劳动奖状、四川省首批文明校园、四川省绿化模范单位称号，是读书治学的理想之地。\"},{\"id\":383,\"name\":\"香港科技大学\",\"en_name\":\"The Hong Kong University of Science and Technology\",\"tags\":\"香港\",\"ranks\":\"47,201-300,47,105,64,64\",\"rank\":400,\"province_id\":32,\"info\":\"香港科技大学，简称科大，是香港的一所公立研究型大学，为环太平洋大学联盟、全球大学校长论坛、东亚研究型大学协会、亚洲大学联盟重要成员，并获AACSB和EQUIS双重认证，是一所世界知名研究型大学。香港科技大学创立于1991年，建校仅三十年，科大现已成为亚洲以至全球领先的研究学府之一，被认为是世界上发展最快的大学之一。该校以科技和商业管理为主、人文及社会科学并重，尤以商科和工科见长，以成功孕育出“DJI大彊无人机”而闻名世界。\"}]}"